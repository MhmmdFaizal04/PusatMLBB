---
export interface Props {
  currentPath: string;
  username: string;
}

const { currentPath, username } = Astro.props;

const links = [
  {
    href: '/admin',
    label: 'Dashboard',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />`,
  },
  {
    href: '/admin/products',
    label: 'Produk',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />`,
  },
  {
    href: '/admin/orders',
    label: 'Pesanan',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />`,
  },
  {
    href: '/admin/customers',
    label: 'Customer',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />`,
  },
  {
    href: '/admin/vouchers',
    label: 'Voucher',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />`,
  },
  {
    href: '/admin/redeem-codes',
    label: 'Redeem Code',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />`,
  },
  {
    href: '/admin/app-version',
    label: 'Versi Aplikasi',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />`,
  },
  {
    href: '/admin/settings',
    label: 'Pengaturan',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`,
  },
];
---

<aside
  id="admin-sidebar"
  class="fixed md:sticky top-0 left-0 z-50 h-dvh w-64 bg-surface border-r border-border flex flex-col transition-transform duration-300 -translate-x-full md:translate-x-0"
>
  <!-- Logo -->
  <div class="h-16 flex items-center px-6 border-b border-border shrink-0">
    <a href="/" class="font-bold text-xl">
      <span class="text-brand">Pusat</span><span class="text-white">MLBB</span>
    </a>
    <span class="ml-2 text-xs font-medium bg-brand/20 text-brand px-2 py-0.5 rounded-full">Admin</span>
  </div>

  <!-- User -->
  <div class="px-4 py-3 border-b border-border shrink-0">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-brand/20 text-brand flex items-center justify-center font-bold text-sm uppercase shrink-0">
        {username.charAt(0)}
      </div>
      <div class="min-w-0">
        <p class="text-sm font-medium text-white truncate">{username}</p>
        <p class="text-xs text-muted">Administrator</p>
      </div>
    </div>
  </div>

  <!-- Nav -->
  <nav class="flex-1 overflow-y-auto py-3 px-3">
    {links.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/admin' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium mb-0.5 transition-colors ${
            isActive
              ? 'bg-brand/10 text-brand'
              : 'text-muted hover:text-white hover:bg-surface-3'
          }`}
        >
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            set:html={link.icon}
          />
          {link.label}
        </a>
      );
    })}
  </nav>

  <!-- Footer -->
  <div class="p-3 border-t border-border shrink-0">
    <button
      onclick="fetch('/api/auth/logout',{method:'POST'}).then(()=>location.href='/')"
      class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-muted hover:text-red-400 hover:bg-red-400/10 transition-colors"
    >
      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      Keluar
    </button>
  </div>
</aside>
