---
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface mt-auto pb-20 md:pb-0">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-10">

      <!-- Brand -->
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-3 w-fit">
          <div class="w-8 h-8 bg-brand rounded-lg flex items-center justify-center text-white font-black text-sm">M</div>
          <span class="font-black text-lg text-text tracking-tight">PusatMLBB</span>
        </a>
        <p class="text-muted text-sm leading-relaxed">
          Pusat jual cheat Mobile Legends terpercaya. Aman, update rutin, harga terjangkau.
        </p>
        <!-- WhatsApp CTA -->
        <a
          href={`https://wa.me/${import.meta.env.PUBLIC_WA_ADMIN}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 mt-4 px-4 py-2 bg-green-600/10 hover:bg-green-600/20 border border-green-600/30 text-green-400 text-sm rounded-xl transition-colors font-medium"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Hubungi Admin
        </a>
      </div>

      <!-- Navigasi -->
      <div>
        <h3 class="text-text font-bold text-sm mb-4 uppercase tracking-wider">Navigasi</h3>
        <ul class="space-y-2.5">
          {/* Navigasi links */}
          {[
            { href: '/', label: 'Beranda' },
            { href: '/products', label: 'Semua Produk' },
            { href: '/login', label: 'Masuk' },
            { href: '/register', label: 'Daftar' },
          ].map((link) => (
            <li>
              <a href={link.href} class="text-muted hover:text-text text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Akun -->
      <div>
        <h3 class="text-text font-bold text-sm mb-4 uppercase tracking-wider">Akun Saya</h3>
        <ul class="space-y-2.5">
          {[
            { href: '/orders', label: 'Riwayat Pesanan' },
            { href: '/files', label: 'File Saya' },
            { href: '/profile', label: 'Profil' },
            { href: '/cart', label: 'Keranjang' },
          ].map((link) => (
            <li>
              <a href={link.href} class="text-muted hover:text-text text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Info -->
      <div>
        <h3 class="text-text font-bold text-sm mb-4 uppercase tracking-wider">Informasi</h3>
        <ul class="space-y-3">
          <li class="flex items-start gap-2 text-sm text-muted">
            <svg class="w-4 h-4 text-brand mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            Anti-Banned, aman digunakan
          </li>
          <li class="flex items-start gap-2 text-sm text-muted">
            <svg class="w-4 h-4 text-brand mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            Update otomatis mengikuti patch
          </li>
          <li class="flex items-start gap-2 text-sm text-muted">
            <svg class="w-4 h-4 text-brand mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Proses cepat setelah konfirmasi
          </li>
          <li class="flex items-start gap-2 text-sm text-muted">
            <svg class="w-4 h-4 text-brand mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            Pembayaran via QRIS
          </li>
        </ul>
      </div>

    </div>

    <!-- Divider & Bottom bar -->
    <div class="border-t border-border pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-muted text-xs">
        &copy; {year} <span class="text-text font-semibold">PusatMLBB</span>. Hak cipta dilindungi.
      </p>
      <div class="flex items-center gap-1.5">
        <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
        <span class="text-muted text-xs">Sistem aktif 24/7</span>
      </div>
    </div>
  </div>
</footer>
