<!-- Social Proof Notification — data hardcoded, no API call -->
<style>
  @keyframes sp-slide-in {
    from { opacity: 0; transform: translateX(-110%) scale(0.92); }
    to   { opacity: 1; transform: translateX(0)    scale(1);    }
  }
  @keyframes sp-slide-out {
    from { opacity: 1; transform: translateX(0)    scale(1);    }
    to   { opacity: 0; transform: translateX(-110%) scale(0.92); }
  }
  @keyframes sp-ping-once {
    0%   { transform: scale(1);    opacity: 1; }
    60%  { transform: scale(1.55); opacity: 0; }
    100% { transform: scale(1.55); opacity: 0; }
  }
  #sp-toast.sp-show  { animation: sp-slide-in  0.45s cubic-bezier(.22,1,.36,1) forwards; }
  #sp-toast.sp-hide  { animation: sp-slide-out 0.35s cubic-bezier(.55,0,1,.45) forwards; }
  #sp-ping { animation: sp-ping-once 1s ease-out 0.5s 1 forwards; }
</style>

<div
  id="sp-toast"
  class="fixed bottom-24 md:bottom-6 left-4 z-50 w-[300px] opacity-0 pointer-events-none"
  aria-live="polite"
>
  <!-- glow border wrapper -->
  <div class="relative rounded-2xl p-[1px] bg-gradient-to-br from-brand/50 via-brand/15 to-transparent shadow-xl shadow-black/10 dark:shadow-black/60">
    <div class="bg-surface border border-border rounded-2xl px-4 py-3.5 flex items-center gap-3">

      <!-- Avatar with pulse ring -->
      <div class="relative shrink-0">
        <div
          id="sp-ping"
          class="absolute inset-0 rounded-full bg-brand/40 opacity-0"
        ></div>
        <div
          id="sp-avatar"
          class="relative w-11 h-11 rounded-full flex items-center justify-center font-black text-base bg-brand/20 text-brand"
        >A</div>
      </div>

      <!-- Content -->
      <div class="min-w-0 flex-1">
        <!-- Badge row -->
        <div class="flex items-center gap-1.5 mb-0.5">
          <span class="inline-flex items-center gap-1 bg-green-500/15 border border-green-500/30 text-green-600 dark:text-green-400 text-[10px] font-bold px-1.5 py-0.5 rounded-full leading-none">
            <span class="w-1.5 h-1.5 rounded-full bg-green-500 dark:bg-green-400 animate-pulse inline-block"></span>
            BARU BELI
          </span>
          <span class="text-faint text-[10px]" id="sp-time">baru saja</span>
        </div>
        <!-- Name -->
        <p class="text-text text-sm font-bold leading-tight truncate" id="sp-name">Abdul</p>
        <!-- Product -->
        <p class="text-muted text-xs leading-snug truncate mt-0.5">
          membeli <span id="sp-product" class="text-brand font-semibold">Drone View X4</span>
        </p>
        <!-- Price -->
        <p class="text-text text-sm font-black mt-1" id="sp-price">Rp 2.500</p>
      </div>

      <!-- Checkmark -->
      <div class="shrink-0 w-9 h-9 rounded-xl bg-green-500/15 border border-green-500/30 flex items-center justify-center">
        <svg class="w-4 h-4 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
    </div>
  </div>
</div>

<script>
  const NAMES = [
    'Abdul', 'Rizky', 'Fajar', 'Dimas', 'Rendi', 'Hendra', 'Bagas', 'Arif',
    'Wahyu', 'Andi', 'Budi', 'Agus', 'Faisal', 'Yoga', 'Gilang', 'Reza',
    'Taufik', 'Dani', 'Ikhsan', 'Lutfi', 'Mahendra', 'Satria', 'Galih', 'Ferdi',
    'Surya', 'Nanda', 'Rama', 'Angga', 'Vino', 'Yusuf',
  ];

  const PRODUCTS = [
    { name: 'Key Room Wangi VIP', price: 15000 },
    { name: 'Spesial Fitur Push Rank Kaja Revamp', price: 50000 },
    { name: 'Room Wangi [ FILE ] Kaja Revamp', price: 50500 },
    { name: 'Damage Kaja Revamp', price: 50500 },
    { name: 'Semi Fitur X2 & X4 Kaja Revamp', price: 16000 },
    { name: 'Full Pack Full Fitur Kaja Revamp', price: 70500 },
    { name: 'Full Pack X1 - X4 Kaja Revamp', price: 10500 },
    { name: 'Drone View X4 Kaja Revamp', price: 2500 },
  ];

  const TIMES = [
    'baru saja', 'baru saja', '1 menit lalu', '2 menit lalu',
    '3 menit lalu', '5 menit lalu', '7 menit lalu',
  ];

  const AVATAR_COLORS = [
    'bg-brand/20 text-brand',
    'bg-blue-500/20 text-blue-400',
    'bg-purple-500/20 text-purple-400',
    'bg-pink-500/20 text-pink-400',
    'bg-yellow-500/20 text-yellow-400',
  ];

  const fmt = (n: number) =>
    new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(n);

  const rand = <T,>(arr: T[]): T => arr[Math.floor(Math.random() * arr.length)];

  const toast    = document.getElementById('sp-toast')!;
  const elName   = document.getElementById('sp-name')!;
  const elProd   = document.getElementById('sp-product')!;
  const elPrice  = document.getElementById('sp-price')!;
  const elTime   = document.getElementById('sp-time')!;
  const elAvatar = document.getElementById('sp-avatar')!;
  const elPing   = document.getElementById('sp-ping')!;

  function showToast() {
    const name    = rand(NAMES);
    const product = rand(PRODUCTS);

    elName.textContent  = name;
    elProd.textContent  = product.name;
    elPrice.textContent = fmt(product.price);
    elTime.textContent  = rand(TIMES);
    elAvatar.textContent = name.charAt(0);
    elAvatar.className  = `relative w-11 h-11 rounded-full flex items-center justify-center font-black text-base ${rand(AVATAR_COLORS)}`;

    // Reset ping animation
    elPing.style.animation = 'none';
    void elPing.offsetWidth;
    elPing.style.animation = '';
    elPing.className = 'absolute inset-0 rounded-full bg-brand/40 opacity-0';

    // Show
    toast.classList.remove('sp-hide');
    toast.classList.add('sp-show');
    toast.style.pointerEvents = 'auto';

    // Hide after 4s
    setTimeout(() => {
      toast.classList.remove('sp-show');
      toast.classList.add('sp-hide');
      toast.style.pointerEvents = 'none';
    }, 4000);
  }

  // Interval: muncul pertama 2–4 detik, lalu setiap 8–14 detik
  function scheduleNext() {
    const delay = 8000 + Math.random() * 6000;
    setTimeout(() => { showToast(); scheduleNext(); }, delay);
  }

  const firstDelay = 2000 + Math.random() * 2000;
  setTimeout(() => { showToast(); scheduleNext(); }, firstDelay);
</script>
