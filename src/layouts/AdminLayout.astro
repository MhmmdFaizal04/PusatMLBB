---
import BaseHead from '../components/layout/BaseHead.astro';
import AdminSidebar from '../components/layout/AdminSidebar.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'Admin Panel - PusatMLBB', description } = Astro.props;
const user = Astro.locals.user;
const currentPath = new URL(Astro.request.url).pathname;
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead title={title} description={description} />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="bg-bg text-text h-dvh flex overflow-hidden">
    <AdminSidebar currentPath={currentPath} username={user?.username ?? 'Admin'} />
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
      <header class="shrink-0 z-30 bg-surface border-b border-border px-6 py-4 flex items-center justify-between">
        <!-- Mobile hamburger -->
        <button
          id="sidebar-toggle"
          class="md:hidden text-muted hover:text-text transition-colors"
          aria-label="Toggle sidebar"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        <h1 class="text-lg font-semibold text-text">{title.replace(' - PusatMLBB', '')}</h1>
        <a
          href="/"
          class="text-sm text-muted hover:text-brand transition-colors"
          target="_blank"
          rel="noopener noreferrer"
        >
          Lihat Toko
        </a>
      </header>
      <main class="flex-1 p-6 overflow-y-auto">
        <slot />
      </main>
    </div>
    <script>
      const toggle = document.getElementById('sidebar-toggle');
      const sidebar = document.getElementById('admin-sidebar');
      toggle?.addEventListener('click', () => {
        sidebar?.classList.toggle('-translate-x-full');
      });
    </script>
  </body>
</html>
