---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 - Halaman Tidak Ditemukan | PusatMLBB">
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4">
    <h1 class="text-8xl font-black text-brand mb-2">404</h1>
    <h2 class="text-2xl font-bold text-white mb-3">Halaman tidak ditemukan</h2>
    <p class="text-muted max-w-sm mb-8">Halaman yang kamu cari tidak ada atau sudah dipindahkan.</p>
    <div class="flex gap-3">
      <a href="/" class="px-5 py-2.5 bg-brand hover:bg-brand-hover text-white font-semibold rounded-xl transition-colors text-sm">
        Ke Beranda
      </a>
      <a href="/products" class="px-5 py-2.5 border border-border hover:border-brand/40 text-white font-medium rounded-xl transition-colors text-sm">
        Lihat Produk
      </a>
    </div>
  </div>
</Layout>
