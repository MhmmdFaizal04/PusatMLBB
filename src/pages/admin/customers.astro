---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { sql } from '../../lib/db';

const customers = await sql`
  SELECT u.id, u.email, u.username, u.created_at,
         COUNT(o.id)::int AS order_count
  FROM users u
  LEFT JOIN orders o ON o.user_id = u.id
  WHERE u.role = 'customer' AND u.is_deleted = FALSE
  GROUP BY u.id
  ORDER BY u.created_at DESC
`.catch(() => []);
---

<AdminLayout title="Customer - PusatMLBB">
  <p class="text-muted text-sm mb-4">{customers.length} customer aktif</p>

  <div class="bg-surface border border-border rounded-2xl overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-border">
          <tr class="text-left">
            <th class="px-4 py-3 text-xs font-semibold text-muted">Username</th>
            <th class="px-4 py-3 text-xs font-semibold text-muted hidden sm:table-cell">Email</th>
            <th class="px-4 py-3 text-xs font-semibold text-muted">Order</th>
            <th class="px-4 py-3 text-xs font-semibold text-muted hidden md:table-cell">Bergabung</th>
            <th class="px-4 py-3 text-xs font-semibold text-muted text-right">Aksi</th>
          </tr>
        </thead>
        <tbody>
          {customers.map((c: any) => (
            <tr class="border-b border-border last:border-0 hover:bg-surface-2 transition-colors" data-row-id={c.id}>
              <td class="px-4 py-3">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-full bg-brand/10 text-brand text-xs font-bold flex items-center justify-center uppercase shrink-0">
                    {c.username.charAt(0)}
                  </div>
                  <span class="font-medium text-white">{c.username}</span>
                </div>
              </td>
              <td class="px-4 py-3 text-muted hidden sm:table-cell">{c.email}</td>
              <td class="px-4 py-3 text-white">{c.order_count}</td>
              <td class="px-4 py-3 text-muted text-xs hidden md:table-cell">
                {new Date(c.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
              </td>
              <td class="px-4 py-3 text-right">
                <button
                  class="del-customer text-xs px-3 py-1.5 bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 text-red-400 rounded-lg transition-colors"
                  data-id={c.id} data-name={c.username}
                >
                  Hapus
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {customers.length === 0 && (
        <div class="text-center py-12 text-muted text-sm">Belum ada customer.</div>
      )}
    </div>
  </div>

  <script>
    document.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('.del-customer') as HTMLElement | null;
      if (!btn) return;
      const id = btn.dataset.id!;
      const name = btn.dataset.name!;
      if (!confirm(`Hapus customer "${name}"? Data order tetap tersimpan.`)) return;
      btn.textContent = 'Menghapus...';
      const res = await fetch(`/api/admin/customers/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.ok) {
        document.querySelector(`[data-row-id="${id}"]`)?.remove();
      } else {
        alert(data.error || 'Gagal menghapus customer');
        btn.textContent = 'Hapus';
      }
    });
  </script>
</AdminLayout>
