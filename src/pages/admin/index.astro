---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { sql } from '../../lib/db';

const [stats, dailyData] = (await Promise.all([
  sql`
    SELECT
      (SELECT COUNT(DISTINCT ip_hash)::int FROM visitor_logs WHERE created_at >= NOW() - INTERVAL '24 hours') AS today_visitors,
      (SELECT COUNT(DISTINCT ip_hash)::int FROM visitor_logs WHERE created_at >= NOW() - INTERVAL '7 days') AS week_visitors,
      (SELECT COUNT(*)::int FROM users WHERE role = 'customer' AND is_deleted = FALSE) AS total_customers,
      (SELECT COUNT(*)::int FROM orders WHERE status = 'pending_approval') AS pending_orders,
      (SELECT COALESCE(SUM(total_amount), 0)::bigint FROM orders WHERE status = 'approved') AS total_revenue,
      (SELECT COUNT(*)::int FROM products WHERE is_available = TRUE) AS active_products
  `.catch(() => [{}]),
  sql`
    SELECT DATE(created_at) AS date, COUNT(DISTINCT ip_hash)::int AS visitors
    FROM visitor_logs
    WHERE created_at >= NOW() - INTERVAL '14 days'
    GROUP BY DATE(created_at) ORDER BY date ASC
  `.catch(() => []),
])) as [any[], any[]];

const s = (stats[0] ?? {}) as any;
const fmt = (p: number) =>
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(p);

const recentOrders = (await sql`
  SELECT o.id, o.total_amount, o.status, o.created_at, u.username
  FROM orders o JOIN users u ON u.id = o.user_id
  ORDER BY o.created_at DESC LIMIT 5
`.catch(() => [])) as any[];

// Chart data
const maxVisitors = Math.max(...dailyData.map((d: any) => d.visitors as number), 1);

// SVG line chart calculations (viewBox 300x100, chart area: left=24, right=8, top=8, bottom=24)
const svgW = 300, svgH = 130;
const padL = 24, padR = 8, padT = 10, padB = 28;
const chartW = svgW - padL - padR;
const chartH = svgH - padT - padB;
const n = dailyData.length;
const points = dailyData.map((d: any, i: number) => {
  const x = padL + (n <= 1 ? chartW / 2 : (i / (n - 1)) * chartW);
  const y = padT + chartH - Math.max(0, (d.visitors / maxVisitors)) * chartH;
  return { x, y, d };
});
const polyline = points.map((p: any) => `${p.x},${p.y}`).join(' ');
const fillPath = points.length > 0
  ? `M${points[0].x},${padT + chartH} ` +
    points.map((p: any) => `L${p.x},${p.y}`).join(' ') +
    ` L${points[points.length - 1].x},${padT + chartH} Z`
  : '';
---

<AdminLayout title="Dashboard - PusatMLBB">
  <!-- Stats Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
    {[
      { label: 'Pengunjung Hari Ini', value: s.today_visitors ?? 0, sub: `${s.week_visitors ?? 0} minggu ini`, color: 'text-brand' },
      { label: 'Total Customer', value: s.total_customers ?? 0, sub: 'Aktif', color: 'text-blue-600 dark:text-blue-400' },
      { label: 'Menunggu Konfirmasi', value: s.pending_orders ?? 0, sub: 'Perlu tindakan', color: 'text-amber-600 dark:text-amber-400' },
      { label: 'Produk Aktif', value: s.active_products ?? 0, sub: 'Tersedia', color: 'text-green-600 dark:text-green-400' },
      { label: 'Total Pendapatan', value: fmt(Number(s.total_revenue ?? 0)), sub: 'Dari order disetujui', color: 'text-brand', wide: true },
    ].map((card) => (
      <div class={`bg-surface border border-border rounded-2xl p-5 ${card.wide ? 'col-span-2 lg:col-span-1' : ''}`}>
        <p class="text-xs text-muted mb-1">{card.label}</p>
        <p class={`text-2xl font-black ${card.color}`}>{card.value}</p>
        <p class="text-xs text-muted mt-0.5">{card.sub}</p>
      </div>
    ))}
  </div>

  <div class="grid lg:grid-cols-2 gap-6">
    <!-- Visitor Chart -->
    <div class="bg-surface border border-border rounded-2xl p-5 flex flex-col">
      <h2 class="font-semibold text-text mb-4 text-sm shrink-0">Pengunjung 14 Hari Terakhir</h2>
      {dailyData.length === 0 ? (
        <p class="text-muted text-sm text-center py-8">Belum ada data.</p>
      ) : (
        <div class="flex-1 min-h-0" style="min-height: 200px">
          <svg viewBox={`0 0 ${svgW} ${svgH}`} class="w-full h-full" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="chartFill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--color-brand)" stop-opacity="0.22"/>
              <stop offset="100%" stop-color="var(--color-brand)" stop-opacity="0.02"/>
            </linearGradient>
          </defs>

          {/* Grid lines */}
          {[0, 0.25, 0.5, 0.75, 1].map((t) => {
            const y = padT + t * chartH;
            const val = Math.round(maxVisitors * (1 - t));
            return (
              <>
                <line x1={padL} y1={y} x2={svgW - padR} y2={y} stroke="var(--color-border)" stroke-width="0.5" />
                <text x={padL - 3} y={y + 3} text-anchor="end" font-size="5" fill="var(--color-faint)">{val}</text>
              </>
            );
          })}

          {/* Area fill */}
          <path d={fillPath} fill="url(#chartFill)" />

          {/* Line */}
          <polyline
            points={polyline}
            fill="none"
            stroke="var(--color-brand)"
            stroke-width="1.5"
            stroke-linejoin="round"
            stroke-linecap="round"
          />

          {/* Dots + labels */}
          {points.map((p: any, i: number) => (
            <>
              <circle cx={p.x} cy={p.y} r="2" fill="var(--color-brand)" stroke="var(--color-surface)" stroke-width="1" />
              {/* Show date label every ~2 points to avoid overlap */}
              {(i === 0 || i === n - 1 || i % 2 === 0) && (
                <text
                  x={p.x}
                  y={svgH - 2}
                  text-anchor="middle"
                  font-size="5"
                  fill="var(--color-faint)"
                >
                  {new Date(p.d.date).getDate()}/{new Date(p.d.date).getMonth() + 1}
                </text>
              )}
            </>
          ))}
        </svg>
        </div>
      )}
    </div>

    <!-- Recent Orders -->
    <div class="bg-surface border border-border rounded-2xl p-5">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-semibold text-text text-sm">Pesanan Terbaru</h2>
        <a href="/admin/orders" class="text-xs text-brand hover:underline">Lihat semua</a>
      </div>
      {recentOrders.length === 0 ? (
        <p class="text-muted text-sm text-center py-8">Belum ada pesanan.</p>
      ) : (
        <div class="flex flex-col gap-2">
          {recentOrders.map((o: any) => (
            <div class="flex items-center justify-between py-2 border-b border-border last:border-0">
              <div class="min-w-0">
                <p class="text-sm font-medium text-text truncate">{o.username}</p>
                <p class="text-xs text-muted">{fmt(o.total_amount)}</p>
              </div>
              <span class={`text-[10px] font-semibold px-2 py-0.5 rounded-full border shrink-0 ${
                o.status === 'approved' ? 'bg-green-500/10 text-green-600 dark:text-green-400 border-green-500/20' :
                o.status === 'pending_approval' ? 'bg-brand/10 text-brand border-brand/20' :
                o.status === 'rejected' ? 'bg-red-500/10 text-red-600 dark:text-red-400 border-red-500/20' :
                'bg-surface-3 text-muted border-border'
              }`}>{o.status}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</AdminLayout>
