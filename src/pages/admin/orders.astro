---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { sql } from '../../lib/db';

const status = Astro.url.searchParams.get('status') || '';

const orders = (status
  ? await sql`
      SELECT o.*, u.username, u.email
      FROM orders o JOIN users u ON u.id = o.user_id
      WHERE o.status = ${status}
      ORDER BY o.created_at DESC
    `.catch(() => [])
  : await sql`
      SELECT o.*, u.username, u.email
      FROM orders o JOIN users u ON u.id = o.user_id
      ORDER BY o.created_at DESC
    `.catch(() => [])) as any[];

const orderIds = orders.map((o: any) => o.id as string);
let orderItems: any[] = [];
if (orderIds.length > 0) {
  orderItems = await sql`
    SELECT oi.order_id, oi.product_name, oi.quantity, oi.price_at_purchase
    FROM order_items oi WHERE oi.order_id = ANY(${orderIds})
  `.catch(() => []);
}

const fmt = (p: number) =>
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(p);

const statusOpts = [
  { value: '', label: 'Semua' },
  { value: 'pending_approval', label: 'Menunggu Konfirmasi' },
  { value: 'approved', label: 'Disetujui' },
  { value: 'rejected', label: 'Ditolak' },
];
---

<AdminLayout title="Pesanan - PusatMLBB">
  <!-- Filter + Bulk Actions -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div class="flex flex-wrap gap-2">
      {statusOpts.map((opt) => (
        <a
          href={opt.value ? `/admin/orders?status=${opt.value}` : '/admin/orders'}
          class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${status === opt.value ? 'bg-brand text-white' : 'bg-surface border border-border text-muted hover:text-white'}`}
        >
          {opt.label}
        </a>
      ))}
    </div>

    {/* Show Setujui Semua only when there are pending orders visible */}
    {orders.some((o: any) => o.status === 'pending_approval') && (
      <button
        id="approve-all-btn"
        class="flex items-center gap-2 px-4 py-2 bg-green-500/10 hover:bg-green-500/20 border border-green-500/30 text-green-400 font-semibold text-sm rounded-xl transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Setujui Semua ({orders.filter((o: any) => o.status === 'pending_approval').length})
      </button>
    )}
  </div>

  {orders.length === 0 ? (
    <div class="text-center py-16 bg-surface border border-border rounded-2xl text-muted text-sm">Belum ada pesanan.</div>
  ) : (
    <div class="flex flex-col gap-4">
      {orders.map((order: any) => {
        const items = orderItems.filter((i: any) => i.order_id === order.id);
        return (
          <div class="bg-surface border border-border rounded-2xl p-5" data-order-id={order.id}>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-mono text-xs text-muted">#{order.id.slice(0, 8)}...</span>
                  <span class={`text-[10px] font-semibold px-2 py-0.5 rounded-full border ${
                    order.status === 'approved' ? 'bg-green-500/10 text-green-400 border-green-500/20' :
                    order.status === 'pending_approval' ? 'bg-brand/10 text-brand border-brand/20' :
                    order.status === 'rejected' ? 'bg-red-500/10 text-red-400 border-red-500/20' :
                    'bg-surface-3 text-muted border-border'
                  }`}>{order.status}</span>
                </div>
                <p class="text-white font-semibold text-sm mt-1">{order.username} <span class="text-muted font-normal">({order.email})</span></p>
                <p class="text-xs text-muted">{new Date(order.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' })}</p>
              </div>
              <div class="text-right shrink-0">
                <p class="text-brand font-black text-lg">{fmt(order.total_amount)}</p>
              </div>
            </div>

            <!-- Items -->
            <div class="bg-surface-2 rounded-xl p-3 mb-3 text-sm flex flex-col gap-1">
              {items.map((i: any) => (
                <div class="flex justify-between">
                  <span class="text-muted">{i.product_name} x{i.quantity}</span>
                  <span class="text-white">{fmt(i.price_at_purchase * i.quantity)}</span>
                </div>
              ))}
            </div>

            <div class="flex flex-wrap items-center gap-2">
              {order.proof_image_url && (
                <a href={order.proof_image_url} target="_blank" rel="noopener noreferrer"
                  class="text-xs px-3 py-1.5 bg-surface-3 hover:bg-surface-2 border border-border text-white rounded-lg transition-colors">
                  Lihat Bukti Bayar
                </a>
              )}
              {order.status === 'pending_approval' && (
                <>
                  <button
                    class="approve-btn text-xs px-3 py-1.5 bg-green-500/10 hover:bg-green-500/20 border border-green-500/20 text-green-400 rounded-lg transition-colors font-medium"
                    data-id={order.id}
                  >
                    Setujui
                  </button>
                  <button
                    class="reject-btn text-xs px-3 py-1.5 bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 text-red-400 rounded-lg transition-colors font-medium"
                    data-id={order.id}
                  >
                    Tolak
                  </button>
                </>
              )}
            </div>
          </div>
        );
      })}
    </div>
  )}

  <script>
    // Setujui Semua
    document.getElementById('approve-all-btn')?.addEventListener('click', async () => {
      const pendingBtns = Array.from(document.querySelectorAll<HTMLElement>('.approve-btn'));
      if (pendingBtns.length === 0) return;
      if (!confirm(`Setujui semua ${pendingBtns.length} pesanan yang menunggu konfirmasi?`)) return;

      const btn = document.getElementById('approve-all-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Memproses...';

      const ids = pendingBtns.map((b) => b.dataset.id!);
      let successCount = 0;

      await Promise.all(
        ids.map(async (id) => {
          const res = await fetch(`/api/orders/${id}/approve`, { method: 'PUT' });
          if (res.ok) successCount++;
        })
      );

      if (successCount === ids.length) {
        window.location.reload();
      } else {
        alert(`${successCount} dari ${ids.length} pesanan berhasil disetujui. Refresh halaman.`);
        btn.disabled = false;
        btn.textContent = `Setujui Semua (${ids.length})`;
      }
    });

    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;

      const approveBtn = target.closest('.approve-btn') as HTMLElement | null;
      if (approveBtn) {
        const id = approveBtn.dataset.id!;
        if (!confirm('Setujui pesanan ini?')) return;
        approveBtn.textContent = 'Memproses...';
        const res = await fetch(`/api/orders/${id}/approve`, { method: 'PUT' });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Gagal menyetujui pesanan');
          approveBtn.textContent = 'Setujui';
        }
      }

      const rejectBtn = target.closest('.reject-btn') as HTMLElement | null;
      if (rejectBtn) {
        const id = rejectBtn.dataset.id!;
        if (!confirm('Tolak pesanan ini?')) return;
        rejectBtn.textContent = 'Memproses...';
        const res = await fetch(`/api/orders/${id}/reject`, { method: 'PUT' });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Gagal menolak pesanan');
          rejectBtn.textContent = 'Tolak';
        }
      }
    });
  </script>
</AdminLayout>
