---
import Layout from '../layouts/Layout.astro';
import { sql } from '../lib/db';

const user = Astro.locals.user!;

const [cartItems, qrisRows] = (await Promise.all([
  sql`
    SELECT ci.quantity, ci.cheat_duration,
           p.id AS product_id, p.name, p.stock, p.is_available,
           COALESCE(cap.price, p.price) AS price
    FROM cart_items ci
    JOIN products p ON p.id = ci.product_id
    LEFT JOIN cheat_app_prices cap
      ON cap.product_id = p.id AND cap.duration = ci.cheat_duration
    WHERE ci.user_id = ${user.userId}
  `.catch(() => []),
  sql`SELECT image_url FROM qris_settings WHERE id = 1`.catch(() => []),
])) as [any[], any[]];

const DURATION_LABELS: Record<string, string> = {
  '3d': '3 Hari', '7d': '7 Hari', '30d': '1 Bulan', 'permanent': 'Permanent',
};

if (cartItems.length === 0) return Astro.redirect('/cart');

const total = cartItems.reduce(
  (s: number, i: any) => s + (i.price as number) * (i.quantity as number), 0
);
const qrisUrl = qrisRows[0]?.image_url ?? null;

const fmt = (p: number) =>
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(p);
---

<Layout title="Checkout - PusatMLBB">
  <div class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-black text-white mb-6">Pembayaran</h1>

    <!-- Voucher -->
    <div class="bg-surface border border-border rounded-2xl p-5 mb-5">
      <h2 class="font-semibold text-white mb-3 text-sm">Kode Voucher</h2>
      <div class="flex gap-2">
        <input
          type="text" id="voucher-input" placeholder="Masukkan kode voucher"
          class="flex-1 bg-bg border border-border rounded-xl px-3 py-2.5 text-white text-sm placeholder:text-muted focus:outline-none focus:border-brand/50 uppercase"
        />
        <button
          id="voucher-apply-btn"
          class="px-4 py-2.5 bg-brand hover:bg-brand-hover text-white font-semibold rounded-xl text-sm transition-colors disabled:opacity-60"
        >Pakai</button>
        <button
          id="voucher-remove-btn"
          class="hidden px-4 py-2.5 bg-surface-2 hover:bg-surface-3 border border-border text-muted hover:text-white rounded-xl text-sm transition-colors"
        >Hapus</button>
      </div>
      <div id="voucher-msg" class="hidden mt-2 text-xs px-1"></div>
    </div>

    <!-- Order Summary -->
    <div class="bg-surface border border-border rounded-2xl p-5 mb-5">
      <h2 class="font-semibold text-white mb-3 text-sm">Ringkasan Pesanan</h2>
      <div class="flex flex-col gap-2">
        {cartItems.map((item: any) => (
          <div class="flex justify-between text-sm">
            <span class="text-muted">{item.name}{item.cheat_duration ? ` (${DURATION_LABELS[item.cheat_duration] ?? item.cheat_duration})` : ''} x{item.quantity}</span>
            <span class="text-white font-medium">{fmt(item.price * item.quantity)}</span>
          </div>
        ))}
        <div id="discount-row" class="hidden justify-between text-sm text-green-400">
          <span>Diskon Voucher</span>
          <span id="discount-display">-Rp0</span>
        </div>
        <div class="border-t border-border pt-2 mt-1 flex justify-between font-bold">
          <span class="text-white">Total</span>
          <span id="total-display" class="text-brand text-lg">{fmt(total)}</span>
        </div>
      </div>
    </div>

    <!-- QRIS Payment -->
    <div class="bg-surface border border-border rounded-2xl p-5 mb-5">
      <h2 class="font-semibold text-white mb-3 text-sm">Scan QRIS untuk Transfer</h2>
      {qrisUrl ? (
        <div class="flex flex-col items-center gap-3">
          <div class="bg-white p-3 rounded-xl inline-block">
            <img src={qrisUrl} alt="QRIS Payment PusatMLBB" class="w-56 h-56 object-contain" />
          </div>
          <p class="text-muted text-xs text-center">Transfer tepat <span id="qris-total-display" class="text-brand font-bold">{fmt(total)}</span></p>
        </div>
      ) : (
        <div class="text-center py-6 text-muted text-sm">
          QRIS belum disetup. Hubungi admin.
        </div>
      )}
    </div>

    <!-- Upload Proof -->
    <div class="bg-surface border border-border rounded-2xl p-5">
      <h2 class="font-semibold text-white mb-1 text-sm">Upload Bukti Transfer</h2>
      <p class="text-muted text-xs mb-4">Upload screenshot/foto bukti transfer. Format: JPG, PNG (maks 5MB)</p>

      <div id="error-msg" class="hidden mb-4 p-3 bg-red-500/10 border border-red-500/20 rounded-lg text-red-400 text-sm"></div>

      <div class="mb-4">
        <label class="block cursor-pointer">
          <input type="file" id="proof-input" accept="image/jpeg,image/jpg,image/png,image/webp" class="hidden" />
          <div id="drop-area" class="border-2 border-dashed border-border hover:border-brand/40 rounded-xl p-8 text-center transition-colors">
            <svg class="w-10 h-10 mx-auto text-muted mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
            <p class="text-muted text-sm">Klik untuk pilih file</p>
          </div>
        </label>
        <div id="preview-container" class="hidden mt-3">
          <img id="preview-img" src="" alt="Preview bukti bayar" class="max-h-48 rounded-xl border border-border mx-auto" />
          <p id="preview-name" class="text-xs text-muted text-center mt-1"></p>
        </div>
      </div>

      <button
        id="submit-btn"
        class="w-full py-3 bg-brand hover:bg-brand-hover text-white font-semibold rounded-xl transition-colors text-sm disabled:opacity-60 disabled:cursor-not-allowed"
      >
        Kirim Pesanan
      </button>

      <div id="progress" class="hidden mt-3">
        <div class="w-full bg-surface-3 rounded-full h-1.5">
          <div id="progress-bar" class="bg-brand h-1.5 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
        <p id="progress-text" class="text-xs text-muted text-center mt-1">Mengupload...</p>
      </div>
    </div>
  </div>

  <script define:vars={{ originalTotal: total }}>
    const input = document.getElementById('proof-input');
    const previewContainer = document.getElementById('preview-container');
    const previewImg = document.getElementById('preview-img');
    const previewName = document.getElementById('preview-name');
    const submitBtn = document.getElementById('submit-btn');
    const errorMsg = document.getElementById('error-msg');
    const progress = document.getElementById('progress');
    const progressBar = document.getElementById('progress-bar');
    const progressText = document.getElementById('progress-text');

    // ── Voucher state ──────────────────────────────────────────────
    let voucherId = null;
    let discountAmount = 0;
    let finalTotal = originalTotal;

    const fmtRp = (n) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(n);

    const voucherInput = document.getElementById('voucher-input');
    const voucherApplyBtn = document.getElementById('voucher-apply-btn');
    const voucherRemoveBtn = document.getElementById('voucher-remove-btn');
    const voucherMsg = document.getElementById('voucher-msg');
    const discountRow = document.getElementById('discount-row');
    const discountDisplay = document.getElementById('discount-display');
    const totalDisplay = document.getElementById('total-display');
    const qrisTotalDisplay = document.getElementById('qris-total-display');

    function updateTotals() {
      totalDisplay.textContent = fmtRp(finalTotal);
      if (qrisTotalDisplay) qrisTotalDisplay.textContent = fmtRp(finalTotal);
      if (discountAmount > 0) {
        discountDisplay.textContent = `-${fmtRp(discountAmount)}`;
        discountRow.classList.remove('hidden');
        discountRow.classList.add('flex');
      } else {
        discountRow.classList.add('hidden');
        discountRow.classList.remove('flex');
      }
    }

    voucherInput.addEventListener('input', () => {
      voucherInput.value = voucherInput.value.toUpperCase();
    });

    voucherApplyBtn.addEventListener('click', async () => {
      const code = voucherInput.value.trim();
      if (!code) return;
      voucherApplyBtn.disabled = true;
      voucherMsg.className = 'mt-2 text-xs px-1';
      try {
        const res = await fetch('/api/vouchers/validate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);

        voucherId = data.voucher.id;
        discountAmount = data.discount_amount;
        finalTotal = data.final_total;
        updateTotals();

        voucherMsg.textContent = `Voucher berhasil! Hemat ${fmtRp(discountAmount)}`;
        voucherMsg.classList.add('text-green-400');
        voucherMsg.classList.remove('hidden');
        voucherInput.readOnly = true;
        voucherApplyBtn.classList.add('hidden');
        voucherRemoveBtn.classList.remove('hidden');
      } catch (err) {
        voucherMsg.textContent = err.message;
        voucherMsg.classList.add('text-red-400');
        voucherMsg.classList.remove('hidden');
        voucherApplyBtn.disabled = false;
      }
    });

    voucherRemoveBtn.addEventListener('click', () => {
      voucherId = null;
      discountAmount = 0;
      finalTotal = originalTotal;
      updateTotals();
      voucherInput.value = '';
      voucherInput.readOnly = false;
      voucherMsg.classList.add('hidden');
      voucherApplyBtn.classList.remove('hidden');
      voucherApplyBtn.disabled = false;
      voucherRemoveBtn.classList.add('hidden');
    });

    // ── File preview ───────────────────────────────────────────────
    input.addEventListener('change', () => {
      const file = input.files?.[0];
      if (file) {
        previewImg.src = URL.createObjectURL(file);
        previewName.textContent = file.name;
        previewContainer.classList.remove('hidden');
      }
    });

    // ── Submit order ───────────────────────────────────────────────
    submitBtn.addEventListener('click', async () => {
      const file = input.files?.[0];
      if (!file) {
        errorMsg.textContent = 'Pilih bukti pembayaran terlebih dahulu';
        errorMsg.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      errorMsg.classList.add('hidden');
      progress.classList.remove('hidden');
      progressBar.style.width = '30%';
      progressText.textContent = 'Mengupload bukti...';

      try {
        const formData = new FormData();
        formData.append('file', file);
        formData.append('folder', 'proofs');

        const uploadRes = await fetch('/api/upload', { method: 'POST', body: formData });
        const uploadData = await uploadRes.json();
        if (!uploadRes.ok) throw new Error(uploadData.error || 'Gagal mengupload gambar');

        progressBar.style.width = '70%';
        progressText.textContent = 'Membuat pesanan...';

        const orderRes = await fetch('/api/orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            proofUrl: uploadData.url,
            proofPublicId: uploadData.publicId,
            voucherId: voucherId,
          }),
        });
        const orderData = await orderRes.json();
        if (!orderRes.ok) throw new Error(orderData.error || 'Gagal membuat pesanan');

        progressBar.style.width = '100%';
        progressText.textContent = 'Pesanan berhasil dibuat!';
        setTimeout(() => (window.location.href = '/orders'), 800);
      } catch (err) {
        errorMsg.textContent = err.message;
        errorMsg.classList.remove('hidden');
        progress.classList.add('hidden');
        submitBtn.disabled = false;
      }
    });
  </script>
</Layout>
