---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Draft Hoki - Cheat Rank Booster Mobile Legends | Download APK Gratis"
  description="Download Draft Hoki, cheat rank booster Mobile Legends terpercaya. Push rank otomatis dari Warrior ke Mythic, anti banned, gratis selamanya."
  canonicalPath="/draft-hoki"
>

<!-- ═══════════════════════════════════════════════════════════════
     PARTICLE CANVAS BACKGROUND
═══════════════════════════════════════════════════════════════ -->
<canvas id="dh-particles" class="fixed inset-0 pointer-events-none z-0 opacity-40"></canvas>

<!-- ═══════════════════════════════════════════════════════════════
     MARQUEE TICKER
═══════════════════════════════════════════════════════════════ -->
<div class="relative overflow-hidden bg-brand/10 border-b border-brand/20 py-2 z-10">
  <div id="dh-ticker" class="flex gap-8 whitespace-nowrap text-xs font-semibold text-brand">
    {Array(3).fill(null).map(() => (
      <span class="flex items-center gap-6 shrink-0">
        <span>Cheat Rank Booster #1 MLBB</span>
        <span>•</span>
        <span>Win Rate +24%</span>
        <span>•</span>
        <span>10.000+ Download</span>
        <span>•</span>
        <span>100% Anti Banned</span>
        <span>•</span>
        <span>Gratis Selamanya</span>
        <span>•</span>
        <span>Rating 4.9/5.0</span>
        <span>•</span>
      </span>
    ))}
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     HERO SECTION
═══════════════════════════════════════════════════════════════ -->
<section id="dh-hero" class="relative overflow-hidden min-h-screen flex items-center z-10">
  <!-- Animated gradient mesh -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="dh-mesh-1 absolute top-0 left-0 w-[600px] h-[600px] bg-brand/8 rounded-full blur-[120px]"></div>
    <div class="dh-mesh-2 absolute bottom-0 right-0 w-[500px] h-[500px] bg-purple-600/8 rounded-full blur-[100px]"></div>
    <div class="dh-mesh-3 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-brand/5 rounded-full blur-[80px]"></div>
  </div>
  <!-- SVG Grid lines bg -->
  <svg class="absolute inset-0 w-full h-full opacity-[0.03] pointer-events-none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
        <path d="M 60 0 L 0 0 0 60" fill="none" stroke="#F97316" stroke-width="1"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#grid)" />
  </svg>

  <div class="max-w-7xl mx-auto px-4 py-20 md:py-28 w-full relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">

      <!-- Left: Text -->
      <div class="flex-1 text-center lg:text-left flex flex-col items-center lg:items-start gap-6">
        <!-- Animated badge -->
        <div id="dh-badge" class="inline-flex items-center gap-2 text-xs font-bold bg-brand/10 text-brand px-4 py-2 rounded-full border border-brand/30">
          <svg id="dh-lightning" class="w-4 h-4" viewBox="0 0 24 24" fill="none">
            <path id="dh-lightning-path" d="M13 10V3L4 14h7v7l9-11h-7z"
              stroke="#F97316" stroke-width="2" stroke-linejoin="round"
              fill="none" stroke-dasharray="60" stroke-dashoffset="60"/>
          </svg>
          Cheat Rank Booster #1 Mobile Legends
        </div>
        <!-- Split-line animated title -->
        <h1 id="dh-title" class="text-4xl md:text-6xl lg:text-7xl font-black leading-tight tracking-tight">
          <span class="block overflow-hidden"><span class="dh-title-inner block">Draft Hoki</span></span>
          <span class="block overflow-hidden"><span class="dh-title-inner block text-brand">Cheat Rank</span></span>
          <span class="block overflow-hidden">
            <span class="dh-title-inner block">
              <span id="dh-typewriter" class="text-brand"></span><span id="dh-cursor" class="text-brand">|</span>
            </span>
          </span>
        </h1>
        <p id="dh-desc" class="text-muted text-base md:text-lg max-w-xl leading-relaxed">
          Cheat rank booster Mobile Legends terpercaya. Boost rank otomatis, anti banned, proses cepat — dari Warrior langsung tembus Mythic.
        </p>
        <!-- Animated stat counters -->
        <div id="dh-stats" class="flex items-center gap-10 flex-wrap justify-center lg:justify-start">
          <div class="text-center lg:text-left">
            <p class="font-black text-white text-3xl"><span class="dh-counter" data-target="10">0</span>K+</p>
            <p class="text-muted text-xs mt-0.5">Download</p>
          </div>
          <div class="w-px h-10 bg-border"></div>
          <div class="text-center lg:text-left">
            <p class="font-black text-white text-3xl"><span class="dh-counter-decimal" data-target="4.9">0</span>★</p>
            <p class="text-muted text-xs mt-0.5">Rating</p>
          </div>
          <div class="w-px h-10 bg-border"></div>
          <div class="text-center lg:text-left">
            <p class="font-black text-white text-3xl"><span class="dh-counter" data-target="24">0</span>%</p>
            <p class="text-muted text-xs mt-0.5">Win Rate Boost</p>
          </div>
        </div>
        <!-- Magnetic CTA buttons -->
        <div id="dh-cta" class="flex flex-wrap gap-3 justify-center lg:justify-start">
          <a href="#download" class="dh-magnetic inline-flex items-center gap-2 px-7 py-3.5 bg-brand text-white font-bold rounded-2xl text-sm shadow-lg shadow-brand/25 relative overflow-hidden group">
            <span class="dh-magnetic-inner relative z-10 flex items-center gap-2">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 16l-4-4h3V4h2v8h3l-4 4zm-7 2h14v2H5v-2z"/></svg>
              Download APK Gratis
            </span>
            <span class="absolute inset-0 bg-white/10 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></span>
          </a>
          <a href="#preview" class="dh-magnetic inline-flex items-center gap-2 px-7 py-3.5 border border-border hover:border-brand/40 text-white font-semibold rounded-2xl text-sm transition-colors">
            <span class="dh-magnetic-inner flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Lihat Preview
            </span>
          </a>
        </div>
      </div>

      <!-- Right: Phone Mockup with 3D tilt -->
      <div id="dh-mockup" class="flex-1 flex justify-center lg:justify-end relative">
        <div id="dh-phone-wrapper" class="relative w-64 md:w-72" style="perspective: 1000px;">
          <div id="dh-phone-3d" class="relative" style="transform-style: preserve-3d;">
            <!-- Glow ring -->
            <div class="absolute inset-0 rounded-[2.5rem] bg-brand/20 blur-2xl scale-110 dh-phone-glow"></div>
            <!-- Phone frame -->
            <div class="relative bg-surface-2 border-2 border-border rounded-[2.5rem] overflow-hidden shadow-2xl shadow-black/60 dh-phone">
              <!-- Notch -->
              <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-5 bg-black rounded-b-2xl z-20"></div>
              <!-- Sliding screenshots -->
              <div class="aspect-[9/19.5] relative overflow-hidden">
                {[
                  '/draft-hoki/screenshot-1.jpg',
                  '/draft-hoki/screenshot-2.jpg',
                  '/draft-hoki/screenshot-3.jpg',
                  '/draft-hoki/screenshot-4.jpg',
                ].map((src, i) => (
                  <img
                    src={src}
                    alt={`Draft Hoki screenshot ${i+1}`}
                    class={`dh-mockup-slide absolute inset-0 w-full h-full object-cover object-top transition-opacity duration-700 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                    data-slide={i}
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                ))}
                <!-- Slide dots overlay -->
                <div class="absolute bottom-3 left-0 right-0 flex justify-center gap-1.5 z-10">
                  {[0,1,2,3].map(i => (
                    <div class={`dh-mockup-dot w-1.5 h-1.5 rounded-full transition-all duration-300 ${i === 0 ? 'bg-brand w-4' : 'bg-white/40'}`} data-dot={i}></div>
                  ))}
                </div>
              </div>
            </div>
            <!-- Floating badges -->
            <div class="absolute -left-8 top-1/4 bg-surface border border-border rounded-xl px-3 py-2.5 shadow-xl dh-float-badge backdrop-blur-sm">
              <p class="text-[10px] font-semibold text-muted">Win Rate</p>
              <p class="text-brand font-black text-xl leading-none">+24%</p>
            </div>
            <div class="absolute -right-8 top-1/2 bg-surface border border-border rounded-xl px-3 py-2.5 shadow-xl dh-float-badge backdrop-blur-sm">
              <p class="text-[10px] font-semibold text-muted">Rank</p>
              <p class="text-purple-400 font-black text-xl leading-none">Mythic</p>
            </div>
            <div class="absolute -left-4 bottom-1/4 bg-surface border border-border rounded-xl px-3 py-2.5 shadow-xl dh-float-badge backdrop-blur-sm">
              <p class="text-[10px] font-semibold text-muted">Heroes</p>
              <p class="text-blue-400 font-black text-xl leading-none">120+</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div id="dh-scroll-hint" class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
    <p class="text-muted text-xs">Scroll untuk lihat lebih</p>
    <div class="w-6 h-10 border-2 border-border rounded-full flex items-start justify-center pt-1.5">
      <div id="dh-scroll-dot" class="w-1.5 h-1.5 bg-brand rounded-full"></div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     RANK PROGRESSION
═══════════════════════════════════════════════════════════════ -->
<section id="dh-rank-section" class="border-t border-border bg-surface overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 py-16">
    <div class="text-center mb-12">
      <h2 class="dh-section-title text-2xl md:text-3xl font-black text-white mb-3">Dari <span class="text-orange-400">Warrior</span> ke <span class="text-purple-400">Mythic</span></h2>
      <p class="dh-section-sub text-muted text-sm md:text-base max-w-lg mx-auto">Draft Hoki cheat rank booster membantu kamu naik rank step by step, cepat dan aman.</p>
    </div>
    <div class="flex items-center justify-center gap-2 md:gap-4 flex-wrap">
      {[
        {rank:'Warrior', color:'#A0AEC0', abbr:'W'},
        {rank:'Elite', color:'#68D391', abbr:'E'},
        {rank:'Master', color:'#63B3ED', abbr:'M'},
        {rank:'Grandmaster', color:'#9F7AEA', abbr:'GM'},
        {rank:'Epic', color:'#F6AD55', abbr:'EP'},
        {rank:'Legend', color:'#FC8181', abbr:'L'},
        {rank:'Mythic', color:'#A855F7', abbr:'MY'},
      ].map((r, i) => (
        <div class="dh-rank-item flex flex-col items-center gap-2">
          <div class="dh-rank-badge w-12 h-12 md:w-14 md:h-14 rounded-2xl flex items-center justify-center border-2 relative"
               style={`border-color: ${r.color}40; background: ${r.color}15`}>
            <span class="text-xs font-black" style={`color: ${r.color}`}>{r.abbr}</span>
            {i < 6 && (
              <div class="dh-rank-arrow absolute -right-3 md:-right-4 top-1/2 -translate-y-1/2 text-border text-xs z-10">›</div>
            )}
          </div>
          <span class="text-[9px] font-bold" style={`color: ${r.color}`}>{r.rank}</span>
        </div>
      ))}
    </div>
    <div class="max-w-2xl mx-auto mt-8">
      <div class="relative h-2 bg-surface-3 rounded-full border border-border overflow-hidden">
        <div id="dh-rank-bar" class="absolute left-0 top-0 h-full rounded-full bg-gradient-to-r from-orange-700 via-yellow-400 via-teal-400 via-blue-400 to-purple-500" style="width: 0%"></div>
      </div>
      <div class="flex justify-between text-[10px] text-muted mt-1.5">
        <span>Warrior</span>
        <span class="text-purple-400 font-bold">Mythic Glory</span>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     FEATURES
═══════════════════════════════════════════════════════════════ -->
<section id="dh-features" class="max-w-7xl mx-auto px-4 py-16 md:py-20">
  <div class="text-center mb-12">
    <h2 class="dh-section-title text-2xl md:text-3xl font-black text-white mb-3">Kenapa Draft Hoki?</h2>
    <p class="dh-section-sub text-muted max-w-xl mx-auto text-sm md:text-base">Fitur lengkap cheat rank booster yang terbukti efektif untuk push rank lebih cepat dan aman.</p>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {[
      {title:'Boost Rank Otomatis',desc:'Sistem cheat boost rank bekerja otomatis di background, push rank kamu tanpa perlu skill tinggi.',stat:'Auto',statLabel:'Boost Mode',
        svg:'<path d="M13 10V3L4 14h7v7l9-11h-7z"/>'},
      {title:'Anti Banned System',desc:'Teknologi bypass terbaru, 100% tidak terdeteksi sistem anti-cheat Mobile Legends. Aman dipakai setiap hari.',stat:'0%',statLabel:'Ban Rate',
        svg:'<path fill-rule="evenodd" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" clip-rule="evenodd"/>'},
      {title:'Semua Rank Didukung',desc:'Dari Warrior sampai Mythic Glory, semua rank bisa diboost. Pilih target rank kamu dan biarkan aplikasi bekerja.',stat:'All',statLabel:'Rank Support',
        svg:'<path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>'},
      {title:'Update Tiap Patch',desc:'Script dan bypass diperbarui otomatis setiap ada patch ML baru, jadi selalu bisa dipakai tanpa gangguan.',stat:'24h',statLabel:'Update Cycle',
        svg:'<path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd"/>'},
      {title:'Proses Cepat',desc:'Naik rank dalam hitungan jam, bukan hari. Sistem kami dioptimasi untuk kecepatan boost maksimal.',stat:'Cepat',statLabel:'Proses',
        svg:'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>'},
      {title:'Gratis Selamanya',desc:'Download gratis, tidak ada biaya langganan tersembunyi. Semua fitur cheat boost bisa dinikmati gratis.',stat:'Free',statLabel:'Forever',
        svg:'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>'},
    ].map((f) => (
      <div class="dh-feature-card group bg-surface border border-border rounded-2xl p-6 hover:border-brand/40 transition-all duration-300 cursor-default relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-brand/0 to-brand/0 group-hover:from-brand/5 group-hover:to-transparent transition-all duration-500 pointer-events-none rounded-2xl"></div>
        <div class="relative z-10">
          <div class="flex items-start justify-between mb-4">
            <div class="w-9 h-9 rounded-xl bg-brand/20 border border-brand/30 flex items-center justify-center dh-feature-icon shrink-0">
              <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={f.svg}></svg>
            </div>
            <div class="text-right">
              <p class="text-brand font-black text-xl leading-none">{f.stat}</p>
              <p class="text-muted text-[10px]">{f.statLabel}</p>
            </div>
          </div>
          <h3 class="font-bold text-white mb-2 text-sm">{f.title}</h3>
          <p class="text-muted text-xs leading-relaxed">{f.desc}</p>
          <div class="dh-card-line mt-4 h-0.5 w-0 bg-gradient-to-r from-brand to-transparent rounded-full group-hover:w-full transition-all duration-500"></div>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     WIN RATE STATS (SVG Donut + Bars)
═══════════════════════════════════════════════════════════════ -->
<section id="dh-winrate" class="border-t border-border bg-surface">
  <div class="max-w-7xl mx-auto px-4 py-16 md:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="flex flex-col items-center gap-6">
        <h2 class="dh-section-title text-2xl md:text-3xl font-black text-white text-center">Statistik Performa</h2>
        <div class="relative w-52 h-52">
          <svg viewBox="0 0 200 200" class="w-full h-full -rotate-90">
            <circle cx="100" cy="100" r="80" fill="none" stroke="#1A1A1A" stroke-width="20"/>
            <circle id="dh-donut-win" cx="100" cy="100" r="80" fill="none" stroke="#F97316" stroke-width="20"
              stroke-dasharray="502" stroke-dashoffset="502" stroke-linecap="round"/>
            <circle id="dh-donut-purple" cx="100" cy="100" r="58" fill="none" stroke="#A855F7" stroke-width="14"
              stroke-dasharray="364" stroke-dashoffset="364" stroke-linecap="round"/>
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
            <p class="text-3xl font-black text-white"><span id="dh-donut-num">0</span>%</p>
            <p class="text-muted text-xs">Win Rate</p>
          </div>
        </div>
        <div class="flex items-center gap-6 text-xs">
          <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-brand inline-block"></span> Win Rate Avg</span>
          <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-purple-500 inline-block"></span> Rank Up Rate</span>
        </div>
      </div>
      <div class="space-y-5">
        <h3 class="font-black text-white text-lg">Win Rate per Peran</h3>
        {[
          {role:'Roamer / Support', wr: 78, color:'#F97316'},
          {role:'Gold Lane', wr: 72, color:'#A855F7'},
          {role:'Mid Lane', wr: 69, color:'#3B82F6'},
          {role:'Exp Lane', wr: 74, color:'#10B981'},
          {role:'Jungler', wr: 81, color:'#F59E0B'},
        ].map((r) => (
          <div class="dh-wr-row">
            <div class="flex justify-between text-xs mb-1.5">
              <span class="font-semibold text-white">{r.role}</span>
              <span class="font-black" style={`color: ${r.color}`}>{r.wr}%</span>
            </div>
            <div class="w-full h-2 bg-surface-3 rounded-full overflow-hidden border border-border">
              <div class="dh-wr-bar h-full rounded-full" data-width={r.wr} style={`background: ${r.color}; width: 0%`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     SCREENSHOTS
═══════════════════════════════════════════════════════════════ -->
<section id="preview" class="max-w-7xl mx-auto px-4 py-16 md:py-20">
  <div class="text-center mb-12">
    <h2 class="dh-section-title text-2xl md:text-3xl font-black text-white mb-3">Tampilan Cheat Draft Hoki</h2>
        <p class="dh-section-sub text-muted text-sm md:text-base">Bukti nyata cheat rank booster Draft Hoki bekerja — dari tampilan hingga hasil boost.</p>
  </div>
  <div class="max-w-md mx-auto mb-6">
    <div class="h-1 bg-surface-3 rounded-full overflow-hidden border border-border">
      <div id="dh-ss-progress" class="h-full bg-brand rounded-full transition-all duration-300" style="width: 25%"></div>
    </div>
  </div>
  <div id="dh-screenshots" class="flex gap-5 overflow-x-auto pb-4 snap-x snap-mandatory cursor-grab active:cursor-grabbing select-none">
    {[
      {src:'/draft-hoki/screenshot-1.jpg', label:'Tampilan Utama'},
      {src:'/draft-hoki/screenshot-2.jpg', label:'Mode Boost Aktif'},
      {src:'/draft-hoki/screenshot-3.jpg', label:'Hasil Rank Up'},
      {src:'/draft-hoki/screenshot-4.jpg', label:'Anti Banned Log'},
    ].map((ss, i) => (
      <div class="dh-screenshot shrink-0 w-44 md:w-52 snap-center">
        <div class="bg-surface-2 border border-border rounded-3xl overflow-hidden aspect-[9/18] relative group">
          <img src={ss.src} alt={ss.label} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 absolute inset-0 z-10" loading="lazy"/>
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-surface-2 z-0">
            <div class="w-12 h-12 rounded-2xl bg-brand/10 border border-brand/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-brand/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3" stroke-width="1.5"/></svg>
            </div>
            <p class="text-muted/60 text-xs text-center px-4">Screenshot {i+1}<br/>Segera Hadir</p>
          </div>
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-3 z-20">
            <p class="text-white text-xs font-bold text-center">{ss.label}</p>
          </div>
        </div>
        <div class="flex justify-center mt-2">
          <span class="w-2 h-2 rounded-full bg-border dh-ss-dot" data-index={i}></span>
        </div>
      </div>
    ))}
  </div>
</section>

