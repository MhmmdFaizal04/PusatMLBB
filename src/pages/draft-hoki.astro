<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { TextPlugin } from 'gsap/TextPlugin';
  gsap.registerPlugin(ScrollTrigger, TextPlugin);

  // ── PARTICLE CANVAS ──────────────────────────────────────────────
  const canvas = document.getElementById('dh-particles') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  interface Particle { x:number;y:number;vx:number;vy:number;size:number;alpha:number; }
  const particles: Particle[] = Array.from({length:60},()=>({
    x:Math.random()*canvas.width, y:Math.random()*canvas.height,
    vx:(Math.random()-.5)*.4, vy:(Math.random()-.5)*.4,
    size:Math.random()*2+.5, alpha:Math.random()*.5+.1,
  }));
  function drawParticles() {
    ctx.clearRect(0,0,canvas.width,canvas.height);
    particles.forEach(p=>{
      p.x+=p.vx; p.y+=p.vy;
      if(p.x<0)p.x=canvas.width; if(p.x>canvas.width)p.x=0;
      if(p.y<0)p.y=canvas.height; if(p.y>canvas.height)p.y=0;
      ctx.beginPath(); ctx.arc(p.x,p.y,p.size,0,Math.PI*2);
      ctx.fillStyle=`rgba(249,115,22,${p.alpha})`; ctx.fill();
    });
    for(let i=0;i<particles.length;i++) for(let j=i+1;j<particles.length;j++){
      const dx=particles[i].x-particles[j].x, dy=particles[i].y-particles[j].y;
      const d=Math.sqrt(dx*dx+dy*dy);
      if(d<100){ ctx.beginPath(); ctx.moveTo(particles[i].x,particles[i].y); ctx.lineTo(particles[j].x,particles[j].y);
        ctx.strokeStyle=`rgba(249,115,22,${(1-d/100)*.08})`; ctx.lineWidth=.5; ctx.stroke(); }
    }
    requestAnimationFrame(drawParticles);
  }
  drawParticles();
  window.addEventListener('resize',()=>{ canvas.width=window.innerWidth; canvas.height=window.innerHeight; });

  // ── MARQUEE ──────────────────────────────────────────────────────
  const ticker = document.getElementById('dh-ticker');
  if(ticker){ const w=ticker.scrollWidth/3; gsap.to(ticker,{x:-w,duration:30,ease:'none',repeat:-1}); }

  // ── MESH GRADIENTS ───────────────────────────────────────────────
  gsap.to('.dh-mesh-1',{x:60,y:40,duration:8,ease:'sine.inOut',repeat:-1,yoyo:true});
  gsap.to('.dh-mesh-2',{x:-50,y:-30,duration:10,ease:'sine.inOut',repeat:-1,yoyo:true});
  gsap.to('.dh-mesh-3',{scale:1.3,duration:6,ease:'sine.inOut',repeat:-1,yoyo:true});

  // ── SVG LIGHTNING DRAW ───────────────────────────────────────────
  gsap.to('#dh-lightning-path',{strokeDashoffset:0,duration:.8,ease:'power2.out',delay:.3});

  // ── HERO TEXT LINES SLIDE UP ─────────────────────────────────────
  const heroTl = gsap.timeline({defaults:{ease:'power3.out'}});
  heroTl
    .from('#dh-badge',{opacity:0,y:24,duration:.6})
    .from('.dh-title-inner',{y:'110%',duration:.8,stagger:.12},'-=.2')
    .from('#dh-desc',{opacity:0,y:20,duration:.6},'-=.3')
    .from('#dh-stats > *',{opacity:0,y:20,duration:.4,stagger:.1},'-=.3')
    .from('#dh-cta > *',{opacity:0,y:20,scale:.95,duration:.4,stagger:.1},'-=.2')
    .from('#dh-mockup',{opacity:0,x:80,duration:1,ease:'power4.out'},'-=.7');

  // ── TYPEWRITER ───────────────────────────────────────────────────
  const words = ['Otomatis','Anti Banned','Ke Mythic!','Terpercaya'];
  let wIdx = 0;
  const tw = document.getElementById('dh-typewriter');
  const cur = document.getElementById('dh-cursor');
  if(cur) gsap.to(cur,{opacity:0,duration:.5,repeat:-1,yoyo:true,ease:'none'});
  function typeWord(){
    if(!tw) return;
    const word=words[wIdx%words.length];
    gsap.to(tw,{text:{value:word,delimiter:''},duration:word.length*.06,ease:'none',
      onComplete:()=>gsap.delayedCall(1.5,()=>gsap.to(tw,{text:{value:'',delimiter:''},duration:word.length*.04,ease:'none',
        onComplete:()=>{wIdx++;gsap.delayedCall(.3,typeWord);}
      }))
    });
  }
  gsap.delayedCall(1.8,typeWord);

  // ── COUNTER ANIMATION ────────────────────────────────────────────
  ScrollTrigger.create({trigger:'#dh-stats',start:'top 85%',once:true,
    onEnter:()=>{
      document.querySelectorAll<HTMLElement>('.dh-counter').forEach(el=>{
        const t=parseInt(el.dataset.target||'0');
        gsap.to({val:0},{val:t,duration:1.5,ease:'power2.out',onUpdate:function(){el.textContent=Math.round(this.targets()[0].val).toString();}});
      });
      document.querySelectorAll<HTMLElement>('.dh-counter-decimal').forEach(el=>{
        const t=parseFloat(el.dataset.target||'0');
        gsap.to({val:0},{val:t,duration:1.5,ease:'power2.out',onUpdate:function(){el.textContent=this.targets()[0].val.toFixed(1);}});
      });
    }
  });

  // ── PHONE 3D TILT ────────────────────────────────────────────────
  const pw=document.getElementById('dh-phone-wrapper'), p3=document.getElementById('dh-phone-3d');
  if(pw&&p3){
    pw.addEventListener('mousemove',e=>{
      const r=pw.getBoundingClientRect();
      const rx=((e.clientY-r.top-r.height/2)/r.height)*-18;
      const ry=((e.clientX-r.left-r.width/2)/r.width)*18;
      gsap.to(p3,{rotateX:rx,rotateY:ry,duration:.4,ease:'power2.out'});
    });
    pw.addEventListener('mouseleave',()=>gsap.to(p3,{rotateX:0,rotateY:0,duration:.8,ease:'elastic.out(1,.5)'}));
  }
  gsap.to('.dh-phone',{y:-14,duration:3.5,ease:'sine.inOut',repeat:-1,yoyo:true});
  gsap.to('.dh-float-badge',{y:-8,duration:2.5,ease:'sine.inOut',repeat:-1,yoyo:true,stagger:.6});
  gsap.to('.dh-phone-glow',{opacity:.4,scale:1.2,duration:2.5,ease:'sine.inOut',repeat:-1,yoyo:true});

  // ── AUTO SLIDESHOW phone mockup ───────────────────────────────────
  const slides = document.querySelectorAll<HTMLElement>('.dh-mockup-slide');
  const dots = document.querySelectorAll<HTMLElement>('.dh-mockup-dot');
  let current = 0;
  function goSlide(idx: number) {
    slides[current].style.opacity = '0';
    dots[current].style.width = '';
    dots[current].style.background = '';
    current = idx;
    slides[current].style.opacity = '1';
    dots[current].style.width = '16px';
    dots[current].style.background = '#F97316';
  }
  if (slides.length > 1) {
    setInterval(() => goSlide((current + 1) % slides.length), 2500);
  }

  // ── SCROLL DOT ───────────────────────────────────────────────────
  gsap.to('#dh-scroll-dot',{y:14,duration:1.2,ease:'sine.inOut',repeat:-1,yoyo:true});
  ScrollTrigger.create({trigger:'#dh-rank-section',start:'top 80%',
    onEnter:()=>gsap.to('#dh-scroll-hint',{opacity:0,duration:.3})});

  // ── SECTION TITLE REVEALS ────────────────────────────────────────
  gsap.utils.toArray<HTMLElement>('.dh-section-title').forEach(el=>{
    gsap.from(el,{opacity:0,y:30,duration:.7,ease:'power2.out',scrollTrigger:{trigger:el,start:'top 88%'}});
  });
  gsap.utils.toArray<HTMLElement>('.dh-section-sub').forEach(el=>{
    gsap.from(el,{opacity:0,y:20,duration:.6,ease:'power2.out',scrollTrigger:{trigger:el,start:'top 88%'}});
  });

  // ── RANK PROGRESSION ─────────────────────────────────────────────
  gsap.from('.dh-rank-badge',{opacity:0,scale:.4,y:30,duration:.5,ease:'back.out(2)',stagger:.1,
    scrollTrigger:{trigger:'#dh-rank-section',start:'top 80%'}});
  gsap.from('.dh-rank-arrow',{opacity:0,x:-10,duration:.3,stagger:.1,delay:.6,
    scrollTrigger:{trigger:'#dh-rank-section',start:'top 80%'}});
  gsap.to('#dh-rank-bar',{width:'95%',duration:2,ease:'power2.out',
    scrollTrigger:{trigger:'#dh-rank-section',start:'top 80%'}});

  // ── FEATURE CARDS ────────────────────────────────────────────────
  gsap.utils.toArray<HTMLElement>('.dh-feature-card').forEach((card, i) => {
    gsap.from(card, {
      opacity: 0, y: 50, scale: .95, duration: .6, ease: 'power2.out',
      delay: (i % 3) * 0.1,
      scrollTrigger: { trigger: card, start: 'top 92%', once: true },
    });
  });
  gsap.utils.toArray<HTMLElement>('.dh-feature-icon').forEach((icon, i) => {
    gsap.from(icon, {
      scale: 0, duration: .4, ease: 'back.out(3)',
      delay: (i % 3) * 0.1 + 0.1,
      scrollTrigger: { trigger: icon, start: 'top 92%', once: true },
    });
  });

  // ── SVG DONUT + WIN RATE BARS ────────────────────────────────────
  ScrollTrigger.create({trigger:'#dh-winrate',start:'top 80%',once:true,
    onEnter:()=>{
      gsap.to('#dh-donut-win',{strokeDashoffset:502*(1-.74),duration:2,ease:'power2.out'});
      gsap.to('#dh-donut-purple',{strokeDashoffset:364*(1-.62),duration:2.2,ease:'power2.out',delay:.2});
      gsap.to({val:0},{val:74,duration:2,ease:'power2.out',
        onUpdate:function(){const el=document.getElementById('dh-donut-num');if(el)el.textContent=Math.round(this.targets()[0].val).toString();}});
      document.querySelectorAll<HTMLElement>('.dh-wr-bar').forEach(bar=>{
        gsap.to(bar,{width:`${bar.dataset.width}%`,duration:1.5,ease:'power2.out',delay:.3});
      });
    }
  });
  gsap.from('.dh-wr-row',{opacity:0,x:-30,duration:.5,stagger:.1,ease:'power2.out',
    scrollTrigger:{trigger:'#dh-winrate',start:'top 80%'}});

  // ── SCREENSHOTS DRAG SCROLL ──────────────────────────────────────
  const ssc=document.getElementById('dh-screenshots')!;
  const ssp=document.getElementById('dh-ss-progress')!;
  const ssDots=document.querySelectorAll<HTMLElement>('.dh-ss-dot');
  if(ssc){
    let drag=false,sx=0,sl=0;
    ssc.addEventListener('mousedown',e=>{drag=true;sx=e.pageX-ssc.offsetLeft;sl=ssc.scrollLeft;});
    document.addEventListener('mouseup',()=>{drag=false;});
    ssc.addEventListener('mousemove',e=>{if(!drag)return;e.preventDefault();
      ssc.scrollLeft=sl-(e.pageX-ssc.offsetLeft-sx)*1.5;});
    ssc.addEventListener('scroll',()=>{
      const pct=(ssc.scrollLeft/(ssc.scrollWidth-ssc.clientWidth))*100;
      if(ssp)ssp.style.width=`${Math.max(5,pct)}%`;
      const idx=Math.round(ssc.scrollLeft/(ssc.scrollWidth/4));
      ssDots.forEach((d,i)=>{
        d.style.background=i===idx?'#F97316':''; d.style.width=i===idx?'20px':'';
        d.style.borderRadius='4px'; d.style.transition='all .3s';
      });
    });
  }
  gsap.from('.dh-screenshot',{opacity:0,y:40,scale:.9,duration:.5,stagger:.12,ease:'back.out(1.4)',
    scrollTrigger:{trigger:'#dh-screenshots',start:'top 85%'}});

  // ── VIDEO PING RINGS ─────────────────────────────────────────────
  gsap.to('.dh-ping-ring',{scale:1.8,opacity:0,duration:2,ease:'power2.out',repeat:-1});
  gsap.to('.dh-ping-ring-2',{scale:1.6,opacity:0,duration:2.5,ease:'power2.out',repeat:-1,delay:.6});
  gsap.from('#dh-video-wrapper',{opacity:0,y:40,duration:.8,ease:'power2.out',
    scrollTrigger:{trigger:'#dh-video-wrapper',start:'top 85%'}});

  // ── FAQ ACCORDION ────────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.dh-faq-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const item=btn.closest('.dh-faq-item') as HTMLElement;
      const body=item.querySelector<HTMLElement>('.dh-faq-body')!;
      const arrow=item.querySelector<HTMLElement>('.dh-faq-arrow')!;
      const isOpen=item.dataset.open==='true';
      document.querySelectorAll<HTMLElement>('.dh-faq-item').forEach(el=>{
        el.dataset.open='false';
        gsap.to(el.querySelector<HTMLElement>('.dh-faq-body')!,{height:0,duration:.35,ease:'power2.inOut'});
        gsap.to(el.querySelector<HTMLElement>('.dh-faq-arrow')!,{rotate:0,duration:.3});
      });
      if(!isOpen){
        item.dataset.open='true';
        gsap.set(body,{height:'auto'});
        const h=body.offsetHeight;
        gsap.fromTo(body,{height:0},{height:h,duration:.4,ease:'power2.out'});
        gsap.to(arrow,{rotate:180,duration:.3});
      }
    });
  });
  gsap.from('.dh-faq-item',{opacity:0,y:20,duration:.4,stagger:.07,ease:'power2.out',
    scrollTrigger:{trigger:'#dh-faq',start:'top 85%'}});

  // ── DOWNLOAD SECTION ────────────────────────────────────────────
  gsap.from('#dh-download-section',{opacity:0,y:60,scale:.95,duration:.9,ease:'power3.out',
    scrollTrigger:{trigger:'#dh-download-section',start:'top 85%'}});
  gsap.from('#dh-dl-icon',{scale:0,rotation:-15,duration:.7,ease:'back.out(2)',
    scrollTrigger:{trigger:'#dh-download-section',start:'top 85%'}});
  gsap.to('#dh-dl-icon',{y:-8,duration:2,ease:'sine.inOut',repeat:-1,yoyo:true,delay:1});
  gsap.to('#dh-apk-btn',{
    boxShadow:'0 0 40px rgba(249,115,22,.6), 0 0 80px rgba(249,115,22,.2)',
    duration:1.2,ease:'sine.inOut',repeat:-1,yoyo:true,
    scrollTrigger:{trigger:'#dh-apk-btn',start:'top 90%'}
  });
  gsap.to('#dh-wave-path',{
    attr:{d:'M0,20 C360,50 720,10 1080,40 C1260,55 1380,15 1440,25 L1440,0 L0,0 Z'},
    duration:4,ease:'sine.inOut',repeat:-1,yoyo:true
  });

  // ── MAGNETIC BUTTONS ─────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.dh-magnetic').forEach(btn=>{
    const inner=btn.querySelector<HTMLElement>('.dh-magnetic-inner');
    btn.addEventListener('mousemove',e=>{
      const r=btn.getBoundingClientRect();
      const dx=(e.clientX-r.left-r.width/2)*.25;
      const dy=(e.clientY-r.top-r.height/2)*.25;
      gsap.to(btn,{x:dx,y:dy,duration:.3,ease:'power2.out'});
      if(inner)gsap.to(inner,{x:dx*.3,y:dy*.3,duration:.3,ease:'power2.out'});
    });
    btn.addEventListener('mouseleave',()=>{
      gsap.to(btn,{x:0,y:0,duration:.6,ease:'elastic.out(1,.4)'});
      if(inner)gsap.to(inner,{x:0,y:0,duration:.6,ease:'elastic.out(1,.4)'});
    });
  });
</script>

<style>
