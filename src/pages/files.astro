---
import Layout from '../layouts/Layout.astro';
import { sql } from '../lib/db';

const user = Astro.locals.user!;
const now = Date.now();
const rawFiles = (await sql`
  SELECT o.id AS order_id, o.created_at, o.expires_at, o.total_amount,
         oi.product_name, oi.quantity, oi.product_id,
         (p.download_link IS NOT NULL) AS has_link
  FROM orders o
  JOIN order_items oi ON oi.order_id = o.id
  LEFT JOIN products p ON p.id = oi.product_id
  WHERE o.user_id = ${user.userId}
    AND o.status = 'approved'
    AND (o.expires_at IS NULL OR o.expires_at > NOW())
  ORDER BY o.created_at DESC
`.catch(() => [])) as any[];

const files = rawFiles.map((f: any) => {
  const daysLeft = f.expires_at
    ? Math.ceil((new Date(f.expires_at).getTime() - now) / (1000 * 60 * 60 * 24))
    : null;
  const expiryLabel = daysLeft !== null
    ? `Akses berakhir ${daysLeft <= 0 ? 'hari ini' : `${daysLeft} hari lagi`} (${new Date(f.expires_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })})`
    : null;
  const expiryColor = daysLeft !== null
    ? (daysLeft <= 3 ? 'text-red-400' : daysLeft <= 7 ? 'text-yellow-400' : 'text-muted')
    : '';
  return { ...f, daysLeft, expiryLabel, expiryColor };
});
---

<Layout title="File Saya - PusatMLBB">
  <div class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-black text-white mb-2">File Saya</h1>
    <p class="text-muted text-sm mb-6">Link download untuk pesanan yang sudah dikonfirmasi admin.</p>

    {files.length === 0 ? (
      <div class="text-center py-20 bg-surface border border-border rounded-2xl">
        <svg class="w-14 h-14 mx-auto text-border mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <p class="text-muted">Belum ada file yang bisa didownload.</p>
        <p class="text-xs text-muted mt-1">File muncul setelah admin mengkonfirmasi pembayaran.</p>
        <a href="/orders" class="mt-3 inline-block text-brand hover:underline text-sm">Lihat Status Pesanan</a>
      </div>
    ) : (
      <div class="flex flex-col gap-3">
        {files.map((f: any) => (
          <div class="flex items-center justify-between gap-4 bg-surface border border-border rounded-2xl p-4">
            <div class="min-w-0">
              <p class="font-semibold text-white text-sm truncate">{f.product_name}</p>
              <p class="text-xs text-muted mt-0.5">
                {new Date(f.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
                {f.quantity > 1 && ` · Qty: ${f.quantity}`}
              </p>
              {f.expiryLabel && (
                <p class={`text-xs mt-0.5 font-medium ${f.expiryColor}`}>{f.expiryLabel}</p>
              )}
            </div>
            {f.has_link ? (
              <a
                href={`/api/files/${f.order_id}?pid=${f.product_id}`}
                class="flex items-center gap-2 px-4 py-2 bg-brand hover:bg-brand-hover text-white text-sm font-semibold rounded-xl transition-colors shrink-0"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Download
              </a>
            ) : (
              <span class="text-xs text-muted px-4 py-2 border border-border rounded-xl">Link tidak tersedia</span>
            )}
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>
