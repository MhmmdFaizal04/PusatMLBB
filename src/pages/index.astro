---
import Layout from '../layouts/Layout.astro';
import { sql } from '../lib/db';

const featuredProducts = (await sql`
  SELECT p.id, p.name, p.price, p.image_url, p.stock, p.is_available,
         c.name AS category_name, c.slug AS category_slug
  FROM products p
  LEFT JOIN categories c ON c.id = p.category_id
  WHERE p.is_available = TRUE AND p.stock > 0
  ORDER BY p.created_at DESC
  LIMIT 8
`.catch(() => [])) as any[];

const categories = (await sql`SELECT * FROM categories ORDER BY name`.catch(() => [])) as any[];

const fmt = (p: number) =>
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(p);
---

<Layout
  title="PusatMLBB - Jual Cheat Mobile Legends Anti Banned Terpercaya"
  description="Pusat jual cheat Mobile Legends anti-banned terpercaya. Harga murah, aman, proses cepat, selalu update."
  canonicalPath="/"
>
  <!-- Hero -->
  <section class="hero-grid hero-pad relative overflow-hidden border-b border-border">

    <div class="relative max-w-5xl mx-auto px-4 flex flex-col items-center text-center">

      <!-- Announcement pill -->
      <a href="/products" id="hero-pill" class="inline-flex items-center gap-2.5 bg-surface border border-border rounded-pill pl-2 pr-3.5 py-1.5 mb-7 text-[13px] font-medium text-muted shadow-sm hover:border-brand/40 transition-colors">
        <span class="bg-brand text-white font-bold text-[11px] uppercase tracking-[0.02em] px-2.5 py-[3px] rounded-pill">Baru</span>
        <span>Cheat ML terlengkap — anti-banned, update tiap patch</span>
        <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>

      <h1 id="hero-title" class="hero-h1 relative text-text max-w-4xl">

        <!-- Handwritten arrow annotation -->
        <span id="anno-arrow" class="hidden md:flex absolute -top-10 left-0 lg:-left-8 items-start gap-0 pointer-events-none select-none">
          <span class="font-note text-brand rotate-[-9deg] origin-bottom-right">anti&nbsp;banned!</span>
          <svg class="w-14 h-11 text-brand -mt-1" viewBox="0 0 70 52" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path class="scribble-path" d="M4,42 C14,12 42,2 62,16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
            <path class="scribble-path" d="M47,7 L63,15 L53,28" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>

        Cheat Mobile Legends untuk<br />
        <span class="hand-wrap">
          <span class="font-hand text-brand">pemain</span>
          <!-- Wavy scribble underline -->
          <svg class="squiggle" viewBox="0 0 200 14" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path id="scribble-underline" d="M3,9 C20,2 33,14 50,8 C67,2 80,14 98,8 C115,2 130,13 148,7 C165,2 182,11 197,6" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
          </svg>
        </span> serius.
      </h1>

      <p id="hero-sub" class="hero-sub text-muted mt-7">
        Satu tempat untuk semua cheat Mobile Legends — aman, selalu update tiap patch, proses instan setelah pembayaran.
      </p>

      <div id="hero-cta" class="flex items-center gap-3 flex-wrap justify-center mt-8">
        <a href="/products" class="inline-flex items-center gap-2 px-6 py-3.5 bg-brand hover:bg-brand-hover text-white font-semibold rounded-xl transition-all text-sm shadow-[0_4px_14px_-4px] shadow-brand/50 hover:-translate-y-px">
          Lihat Semua Produk
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0l-6-6m6 6l-6 6"/></svg>
        </a>
        <a href="/register" class="px-6 py-3.5 bg-surface border border-border hover:border-brand/40 text-text font-semibold rounded-xl transition-all text-sm hover:-translate-y-px">
          Daftar Gratis
        </a>
        <!-- Dotted handwritten badge -->
        <span id="anno-badge" class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2.5 rounded-pill border-[1.5px] border-dashed border-brand/50 text-brand">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.6 6.3 6.8.5-5.2 4.4 1.6 6.6L12 16.3 6.2 19.8l1.6-6.6L2.6 8.8l6.8-.5L12 2z"/></svg>
          <span class="font-hand-display text-lg leading-none">tanpa ribet</span>
        </span>
      </div>

      <div id="hero-stats" class="flex items-center gap-7 md:gap-10 mt-10 flex-wrap justify-center">
        {[['500+','Customer'],['99%','Kepuasan'],['24/7','Support']].map(([val,label]) => (
          <div class="text-center">
            <p class="font-extrabold text-text text-2xl tracking-[-0.03em] leading-[1.1] tabular-nums">{val}</p>
            <p class="text-faint text-[11.5px] font-medium mt-1">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Draft Hoki Banner -->
  <section id="dh-banner" class="border-b border-border">
    <div class="max-w-7xl mx-auto px-4 py-6 md:py-8">
      <div class="relative overflow-hidden bg-gradient-to-r from-surface-2 via-brand/5 to-surface-2 border border-brand/20 rounded-3xl p-6 md:p-10">
        <div class="absolute inset-0 bg-gradient-to-br from-brand/5 via-transparent to-purple-900/5 pointer-events-none"></div>
        <div class="absolute -top-10 -right-10 w-56 h-56 bg-brand/5 rounded-full blur-3xl pointer-events-none" id="dh-banner-glow"></div>
        <div class="relative z-10 flex flex-col md:flex-row items-center gap-6 md:gap-10">
          <!-- Icon -->
          <div id="dh-banner-icon" class="shrink-0 w-20 h-20 rounded-3xl bg-brand/20 border border-brand/30 flex items-center justify-center shadow-lg shadow-brand/10">
            <svg class="w-10 h-10 text-brand" fill="currentColor" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <!-- Text -->
          <div id="dh-banner-text" class="flex-1 text-center md:text-left">
            <span class="inline-block text-xs font-semibold bg-brand/10 text-brand px-2.5 py-1 rounded-full border border-brand/20 mb-2">
              Rank Booster App
            </span>
            <h2 class="text-xl md:text-2xl font-black text-white mb-1">Download Draft Hoki — Naik Rank Lebih Cepat!</h2>
            <p class="text-muted text-sm max-w-lg">Aplikasi draft & rank booster Mobile Legends gratis. Analisis hero pick terbaik, tier list update otomatis, 100% aman.</p>
          </div>
          <!-- CTA -->
          <a
            id="dh-banner-btn"
            href="/draft-hoki"
            class="shrink-0 inline-flex items-center gap-2 px-6 py-3.5 bg-brand hover:bg-brand-hover text-white font-bold rounded-2xl transition-all text-sm shadow-lg shadow-brand/20 hover:shadow-brand/40 hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 16l-4-4h3V4h2v8h3l-4 4zm-7 2h14v2H5v-2z"/></svg>
            Download Sekarang
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="max-w-7xl mx-auto px-4 py-8">
    <h2 class="text-lg font-bold text-white mb-4">Kategori Game</h2>
    <div class="flex flex-wrap gap-2">
      <a href="/products" class="px-4 py-2 bg-surface-2 hover:bg-brand/10 hover:text-brand border border-border hover:border-brand/30 text-muted text-sm rounded-lg transition-colors font-medium">Semua</a>
      {categories.map((cat: any) => (
        <a href={`/products?category=${cat.slug}`} class="px-4 py-2 bg-surface-2 hover:bg-brand/10 hover:text-brand border border-border hover:border-brand/30 text-muted text-sm rounded-lg transition-colors font-medium">
          {cat.name}
        </a>
      ))}
    </div>
  </section>

  <!-- Products Grid -->
  <section class="max-w-7xl mx-auto px-4 pb-12">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-text">Produk Terbaru</h2>
      <a href="/products" class="text-sm text-brand hover:underline">Lihat semua</a>
    </div>
    {featuredProducts.length === 0 ? (
      <div class="text-center py-16 text-muted">Belum ada produk tersedia.</div>
    ) : (
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {featuredProducts.map((p: any) => (
          <a href={`/products/${p.id}`} class="group bg-surface border border-border rounded-2xl overflow-hidden hover:border-brand/40 transition-all hover:-translate-y-0.5">
            <div class="aspect-[4/3] bg-surface-2 overflow-hidden">
              {p.image_url ? (
                <img src={p.image_url} alt={`Cheat ${p.name}`} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-border">
                  <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                </div>
              )}
            </div>
            <div class="p-3">
              {p.category_name && <span class="text-[10px] font-semibold text-brand uppercase tracking-wide">{p.category_name}</span>}
              <h3 class="text-sm font-semibold text-text mt-0.5 line-clamp-2">{p.name}</h3>
              <div class="flex items-center justify-between mt-2">
                <span class="text-brand font-bold text-sm">{fmt(p.price)}</span>
                {p.stock > 0 ? (
                  <span class="text-[10px] font-medium text-green-400 bg-green-400/10 border border-green-400/20 px-1.5 py-0.5 rounded-full">
                    Sisa {p.stock}
                  </span>
                ) : (
                  <span class="text-[10px] font-medium text-red-400 bg-red-400/10 border border-red-400/20 px-1.5 py-0.5 rounded-full">
                    Habis
                  </span>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  <!-- How to order -->
  <section class="border-t border-border bg-surface">
    <div class="max-w-7xl mx-auto px-4 py-12">
      <h2 class="text-xl font-bold text-text text-center mb-8">Cara Pembelian</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {[
          ['01','Pilih Produk','Browse produk dan tambah ke keranjang'],
          ['02','Transfer QRIS','Scan QRIS dan transfer sesuai nominal'],
          ['03','Upload Bukti','Upload screenshot bukti pembayaran'],
          ['04','Download File','Admin konfirmasi, link download muncul'],
        ].map(([step, title, desc]) => (
          <div class="flex flex-col items-center text-center gap-3">
            <span class="w-10 h-10 rounded-xl bg-brand/10 border border-brand/20 text-brand font-black text-sm flex items-center justify-center">{step}</span>
            <div>
              <p class="font-semibold text-text text-sm">{title}</p>
              <p class="text-muted text-xs mt-0.5">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // ─── SVG Scribble draw animations ──────────────────────────────────────────────
  // Draw each scribble path using the stroke-dashoffset technique
  const scribblePaths = document.querySelectorAll<SVGPathElement>('.scribble-path');
  scribblePaths.forEach((path, i) => {
    const len = path.getTotalLength();
    gsap.set(path, { strokeDasharray: len, strokeDashoffset: len });
    gsap.to(path, {
      strokeDashoffset: 0,
      duration: 0.55,
      ease: 'power2.inOut',
      delay: 0.9 + i * 0.22,
    });
  });

  // Handwritten arrow label fades/rotates in with the stroke
  gsap.from('#anno-arrow span', {
    opacity: 0,
    x: -14,
    rotate: -22,
    duration: 0.6,
    ease: 'back.out(1.7)',
    delay: 1.35,
  });

  // Wavy underline draws after the headline appears
  const underline = document.querySelector<SVGPathElement>('#scribble-underline');
  if (underline) {
    const len = underline.getTotalLength();
    gsap.set(underline, { strokeDasharray: len, strokeDashoffset: len });
    gsap.to(underline, {
      strokeDashoffset: 0,
      duration: 0.9,
      ease: 'power3.inOut',
      delay: 0.85,
    });
  }

  // Dotted "tanpa ribet" badge pops in, then breathes
  const badge = document.querySelector('#anno-badge');
  if (badge) {
    gsap.from(badge, {
      opacity: 0,
      scale: 0.75,
      rotate: -6,
      duration: 0.6,
      ease: 'back.out(2)',
      delay: 1.5,
    });
    gsap.to(badge, {
      rotate: 2,
      y: -3,
      duration: 2.6,
      ease: 'sine.inOut',
      repeat: -1,
      yoyo: true,
      delay: 2.2,
    });
  }

  // ─── Hero ─────────────────────────────────────────────────────────────────────
  const heroTl = gsap.timeline({ defaults: { ease: 'power3.out' } });
  heroTl
    .from('#hero-pill', { opacity: 0, y: 20, duration: 0.5 })
    .from('#hero-title', { opacity: 0, y: 40, duration: 0.7 }, '-=0.2')
    .from('#hero-sub', { opacity: 0, y: 20, duration: 0.5 }, '-=0.4')
    // fromTo + clearProps: a plain .from() here could be reverted to its start
    // state by ScrollTrigger.refresh() on window load and stay invisible.
    .fromTo(
      '#hero-cta > a',
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.5, stagger: 0.08, clearProps: 'opacity,transform' },
      '-=0.3'
    )
    .from('#hero-stats > div', { opacity: 0, y: 15, duration: 0.4, stagger: 0.08 }, '-=0.2');

  // ─── Product cards ─────────────────────────────────────────────────────────────
  gsap.utils.toArray<HTMLElement>('.grid.grid-cols-2 > a').forEach((card, i) => {
    gsap.from(card, {
      opacity: 0,
      y: 30,
      duration: 0.5,
      ease: 'power2.out',
      delay: (i % 4) * 0.07,
      scrollTrigger: {
        trigger: card,
        start: 'top 100%',
        once: true,
      },
    });
  });

  // ─── Draft Hoki Banner ─────────────────────────────────────────────────────────
  gsap.from('#dh-banner > div > div', {
    opacity: 0,
    y: 50,
    scale: 0.97,
    duration: 0.8,
    ease: 'power3.out',
    scrollTrigger: {
      trigger: '#dh-banner',
      start: 'top 85%',
    },
  });

  gsap.from('#dh-banner-icon', {
    opacity: 0,
    scale: 0.5,
    duration: 0.7,
    ease: 'back.out(2)',
    scrollTrigger: {
      trigger: '#dh-banner',
      start: 'top 85%',
    },
  });

  gsap.to('#dh-banner-icon', {
    y: -6,
    duration: 2.5,
    ease: 'sine.inOut',
    repeat: -1,
    yoyo: true,
    delay: 1,
  });

  gsap.to('#dh-banner-glow', {
    scale: 1.3,
    opacity: 0.6,
    duration: 3,
    ease: 'sine.inOut',
    repeat: -1,
    yoyo: true,
  });

  // ─── How to order steps ────────────────────────────────────────────────────────
  gsap.from('.grid.grid-cols-2.md\\:grid-cols-4 > div', {
    opacity: 0,
    y: 30,
    duration: 0.5,
    ease: 'power2.out',
    stagger: 0.15,
    scrollTrigger: {
      trigger: '.grid.grid-cols-2.md\\:grid-cols-4',
      start: 'top 85%',
    },
  });
</script>
