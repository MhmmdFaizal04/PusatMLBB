---
import Layout from '../layouts/Layout.astro';
if (Astro.locals.user) return Astro.redirect('/');
const redirect = Astro.url.searchParams.get('redirect') || '/';
---
<Layout title="Masuk - PusatMLBB" canonicalPath="/login">
  <div class="min-h-[80vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-sm">
      <div class="text-center mb-8">
        <a href="/" class="inline-block font-bold text-2xl mb-4">
          <span class="text-brand">Pusat</span><span class="text-white">MLBB</span>
        </a>
        <h1 class="text-2xl font-black text-white">Masuk ke akun</h1>
        <p class="text-muted text-sm mt-1">Belum punya akun? <a href="/register" class="text-brand hover:underline">Daftar sekarang</a></p>
      </div>

      <div id="error-msg" class="hidden mb-4 p-3 bg-red-500/10 border border-red-500/20 rounded-lg text-red-400 text-sm text-center"></div>

      <form id="login-form" class="flex flex-col gap-4">
        <div>
          <label class="block text-sm font-medium text-white mb-1.5">Email atau Username</label>
          <input
            type="text" name="identifier" required autocomplete="username"
            placeholder="email@example.com atau username"
            class="w-full bg-surface-2 border border-border rounded-xl px-4 py-3 text-white text-sm placeholder:text-muted focus:outline-none focus:border-brand/50 focus:ring-1 focus:ring-brand/30 transition-colors"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-white mb-1.5">Password</label>
          <input
            type="password" name="password" required autocomplete="current-password"
            placeholder="Masukkan password"
            class="w-full bg-surface-2 border border-border rounded-xl px-4 py-3 text-white text-sm placeholder:text-muted focus:outline-none focus:border-brand/50 focus:ring-1 focus:ring-brand/30 transition-colors"
          />
        </div>
        <button
          type="submit" id="submit-btn"
          class="w-full py-3 bg-brand hover:bg-brand-hover text-white font-semibold rounded-xl transition-colors text-sm disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Masuk
        </button>
      </form>
    </div>
  </div>

  <script define:vars={{ redirect }} is:inline>
    const form = document.getElementById('login-form');
    const btn = document.getElementById('submit-btn');
    const errorMsg = document.getElementById('error-msg');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Memproses...';
      errorMsg.classList.add('hidden');

      const fd = new FormData(form);
      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ identifier: fd.get('identifier'), password: fd.get('password') }),
        });
        const data = await res.json();
        if (res.ok) {
          window.location.href = data.role === 'admin' ? '/admin' : redirect;
        } else {
          errorMsg.textContent = data.error || 'Gagal masuk';
          errorMsg.classList.remove('hidden');
        }
      } catch {
        errorMsg.textContent = 'Terjadi kesalahan. Coba lagi.';
        errorMsg.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Masuk';
      }
    });
  </script>
</Layout>
