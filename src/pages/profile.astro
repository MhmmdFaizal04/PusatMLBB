---
import Layout from '../layouts/Layout.astro';
import { sql } from '../lib/db';

const user = Astro.locals.user!;

// Check if customer has at least 1 approved order that hasn't expired
let hasApprovedOrder = false;
let expiresAt: Date | null = null;
let bypassLink: string | null = null;
let tutorialVideoUrl: string | null = null;

if (user.role === 'customer') {
  const [orderCheck, settings] = await Promise.all([
    sql`SELECT expires_at FROM orders WHERE user_id = ${user.userId} AND status = 'approved' AND (expires_at IS NULL OR expires_at > NOW()) ORDER BY expires_at DESC NULLS LAST LIMIT 1`.catch(() => []),
    sql`SELECT bypass_link, tutorial_video_url FROM qris_settings WHERE id = 1`.catch(() => []),
  ]);
  hasApprovedOrder = orderCheck.length > 0;
  expiresAt = orderCheck[0]?.expires_at ? new Date(orderCheck[0].expires_at) : null;
  bypassLink = settings[0]?.bypass_link ?? null;
  tutorialVideoUrl = settings[0]?.tutorial_video_url ?? null;
}

// Sisa hari akses
const daysLeft = expiresAt
  ? Math.max(0, Math.ceil((expiresAt.getTime() - Date.now()) / (1000 * 60 * 60 * 24)))
  : null;

// Convert Google Drive share link to embed URL
function toGDriveEmbed(url: string): string {
  const match = url.match(/\/d\/([a-zA-Z0-9_-]+)/);
  if (match) return `https://drive.google.com/file/d/${match[1]}/preview`;
  return url;
}
---

<Layout title="Profil - PusatMLBB">
  <div class="max-w-lg mx-auto px-4 py-8">
    <h1 class="text-2xl font-black text-white mb-6">Profil Saya</h1>

    <!-- User Info -->
    <div class="bg-surface border border-border rounded-2xl p-5 mb-5">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-brand/10 text-brand flex items-center justify-center text-2xl font-black uppercase">
          {user.username.charAt(0)}
        </div>
        <div>
          <p class="font-bold text-white text-lg">{user.username}</p>
          <p class="text-muted text-sm">{user.email}</p>
          <span class="text-xs font-medium bg-brand/10 text-brand px-2 py-0.5 rounded-full border border-brand/20 capitalize mt-1 inline-block">{user.role}</span>
        </div>
      </div>
    </div>

    <!-- Change Password -->
    <div class="bg-surface border border-border rounded-2xl p-5 mb-5">

    {hasApprovedOrder && (bypassLink || tutorialVideoUrl) && (
      <>
        <!-- Bypass Download -->
        {bypassLink && (
          <div class="bg-surface border border-brand/20 rounded-2xl p-5 mb-5">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-xl bg-brand/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-white text-sm">File Bypass</p>
                <p class="text-xs text-muted">Tersedia karena kamu sudah melakukan pembelian</p>
              </div>
              {daysLeft !== null && (
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-full border shrink-0 ${
                  daysLeft <= 5
                    ? 'bg-red-500/10 text-red-400 border-red-500/20'
                    : daysLeft <= 10
                      ? 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20'
                      : 'bg-green-500/10 text-green-400 border-green-500/20'
                }`}>
                  {daysLeft} hari lagi
                </span>
              )}
            </div>
            <a
              href={bypassLink}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 w-full py-3 bg-brand hover:bg-brand-hover text-white font-semibold rounded-xl transition-colors text-sm"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
              Download Bypass
            </a>
          </div>
        )}

        <!-- Tutorial Video -->
        {tutorialVideoUrl && (
          <div class="bg-surface border border-border rounded-2xl p-5 mb-5">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-9 h-9 rounded-xl bg-red-500/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M15 10l4.553-2.069A1 1 0 0121 8.87v6.26a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-white text-sm">Video Tutorial</p>
                <p class="text-xs text-muted">Cara menggunakan bypass Mobile Legends</p>
              </div>
            </div>
            <div class="relative w-full rounded-xl overflow-hidden bg-black" style="padding-top: 56.25%">
              <iframe
                src={toGDriveEmbed(tutorialVideoUrl)}
                class="absolute inset-0 w-full h-full"
                allow="autoplay"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          </div>
        )}
      </>
    )}
      <h2 class="font-semibold text-white mb-4">Ganti Password</h2>

      <div id="pw-error" class="hidden mb-3 p-3 bg-red-500/10 border border-red-500/20 rounded-lg text-red-400 text-sm"></div>
      <div id="pw-success" class="hidden mb-3 p-3 bg-green-500/10 border border-green-500/20 rounded-lg text-green-400 text-sm"></div>

      <form id="pw-form" class="flex flex-col gap-3">
        <div>
          <label class="block text-sm font-medium text-white mb-1.5">Password Saat Ini</label>
          <input
            type="password" name="currentPassword" required
            placeholder="Password lama"
            class="w-full bg-surface-2 border border-border rounded-xl px-4 py-3 text-white text-sm placeholder:text-muted focus:outline-none focus:border-brand/50 focus:ring-1 focus:ring-brand/30 transition-colors"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-white mb-1.5">Password Baru</label>
          <input
            type="password" name="newPassword" required minlength="8"
            placeholder="Minimal 8 karakter"
            class="w-full bg-surface-2 border border-border rounded-xl px-4 py-3 text-white text-sm placeholder:text-muted focus:outline-none focus:border-brand/50 focus:ring-1 focus:ring-brand/30 transition-colors"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-white mb-1.5">Konfirmasi Password Baru</label>
          <input
            type="password" name="confirmPassword" required
            placeholder="Ulangi password baru"
            class="w-full bg-surface-2 border border-border rounded-xl px-4 py-3 text-white text-sm placeholder:text-muted focus:outline-none focus:border-brand/50 focus:ring-1 focus:ring-brand/30 transition-colors"
          />
        </div>
        <button
          type="submit" id="pw-btn"
          class="mt-2 py-3 bg-brand hover:bg-brand-hover text-white font-semibold rounded-xl transition-colors text-sm disabled:opacity-60"
        >
          Simpan Password Baru
        </button>
      </form>
    </div>

    <!-- Logout -->
    <button
      id="logout-btn"
      class="w-full mt-2 py-3 flex items-center justify-center gap-2 bg-surface border border-border hover:border-red-500/40 hover:bg-red-500/5 text-red-400 font-semibold rounded-2xl transition-colors text-sm"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      Keluar
    </button>
  </div>

  <script>
    // Logout
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/';
    });

    const form = document.getElementById('pw-form') as HTMLFormElement;
    const btn = document.getElementById('pw-btn') as HTMLButtonElement;
    const errEl = document.getElementById('pw-error')!;
    const okEl = document.getElementById('pw-success')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errEl.classList.add('hidden');
      okEl.classList.add('hidden');

      const fd = new FormData(form);
      const newPw = fd.get('newPassword') as string;
      const confirmPw = fd.get('confirmPassword') as string;

      if (newPw !== confirmPw) {
        errEl.textContent = 'Password baru dan konfirmasi tidak cocok';
        errEl.classList.remove('hidden');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Menyimpan...';

      try {
        const res = await fetch('/api/profile/password', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ currentPassword: fd.get('currentPassword'), newPassword: newPw }),
        });
        const data = await res.json();
        if (res.ok) {
          okEl.textContent = 'Password berhasil diubah!';
          okEl.classList.remove('hidden');
          form.reset();
        } else {
          errEl.textContent = data.error || 'Gagal mengubah password';
          errEl.classList.remove('hidden');
        }
      } catch {
        errEl.textContent = 'Terjadi kesalahan. Coba lagi.';
        errEl.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Simpan Password Baru';
      }
    });
  </script>
</Layout>
