---
import Layout from '../layouts/Layout.astro';
import { sql } from '../lib/db';
import { ensureTutorialTable, youtubeThumbnail, type TutorialVideo } from '../lib/tutorials';

await ensureTutorialTable().catch(() => {});

const videos = (await sql`
  SELECT id, title, description, youtube_id, sort_order, is_active, created_at, updated_at
  FROM tutorial_videos
  WHERE is_active = TRUE
  ORDER BY sort_order ASC, created_at ASC
`.catch(() => [])) as TutorialVideo[];
---

<Layout
  title="Tutorial Pasang Config - PusatMLBB"
  description="Kumpulan video tutorial cara pasang config Mobile Legends, step by step, mudah diikuti untuk semua tipe HP."
  canonicalPath="/tutorial"
>
  <!-- Hero -->
  <section class="border-b border-border">
    <div class="max-w-5xl mx-auto px-4 py-14 md:py-20 text-center">
      <span class="inline-flex items-center gap-2 bg-brand/10 text-brand text-xs font-semibold px-3 py-1.5 rounded-pill border border-brand/20 mb-5">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
        Video Tutorial
      </span>
      <h1 class="text-3xl md:text-5xl font-black text-text tracking-[-0.03em] leading-[1.1]">
        Cara Pasang Config<br class="hidden sm:block" /> Mobile Legends
      </h1>
      <p class="text-muted mt-5 max-w-xl mx-auto text-sm md:text-base leading-relaxed">
        Ikuti video di bawah ini langkah demi langkah. Kalau masih bingung, hubungi admin lewat WhatsApp — kami bantu sampai berhasil.
      </p>
    </div>
  </section>

  <!-- Video list -->
  <section class="max-w-5xl mx-auto px-4 py-12 md:py-16">
    {videos.length === 0 ? (
      <div class="text-center py-20">
        <svg class="w-14 h-14 mx-auto text-border mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <p class="text-muted">Video tutorial belum tersedia. Silakan cek lagi nanti.</p>
      </div>
    ) : (
      <div class="space-y-10 md:space-y-14">
        {videos.map((v, i) => (
          <div class="tutorial-item grid md:grid-cols-2 gap-6 md:gap-10 items-center" data-youtube-id={v.youtube_id}>
            <!-- Facade player -->
            <div
              class="yt-facade relative aspect-video w-full rounded-2xl overflow-hidden bg-black border border-border cursor-pointer group"
              data-youtube-id={v.youtube_id}
              role="button"
              tabindex="0"
              aria-label={`Putar video: ${v.title}`}
            >
              <img
                src={youtubeThumbnail(v.youtube_id)}
                alt={`Thumbnail ${v.title}`}
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading={i === 0 ? 'eager' : 'lazy'}
                referrerpolicy="no-referrer"
              />
              <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors flex items-center justify-center">
                <span class="w-16 h-16 rounded-full bg-brand/90 group-hover:bg-brand flex items-center justify-center shadow-xl transition-colors">
                  <svg class="w-7 h-7 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                </span>
              </div>
            </div>

            <!-- Text -->
            <div>
              <span class="inline-block text-xs font-bold text-brand bg-brand/10 border border-brand/20 rounded-full px-2.5 py-1 mb-3">
                Tutorial {String(i + 1).padStart(2, '0')}
              </span>
              <h2 class="text-xl md:text-2xl font-bold text-text leading-snug">{v.title}</h2>
              {v.description && (
                <p class="text-muted text-sm md:text-[15px] mt-3 leading-relaxed whitespace-pre-line">{v.description}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  <!-- CTA -->
  <section class="border-t border-border bg-surface">
    <div class="max-w-3xl mx-auto px-4 py-14 text-center">
      <h2 class="text-xl md:text-2xl font-bold text-text">Masih bingung cara pasangnya?</h2>
      <p class="text-muted text-sm mt-2">Tim kami siap bantu langsung lewat WhatsApp.</p>
      <div class="flex items-center justify-center gap-3 mt-6 flex-wrap">
        <a
          href={`https://wa.me/${import.meta.env.PUBLIC_WA_ADMIN}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-xl text-sm transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Hubungi Admin
        </a>
        <a
          href="/products"
          class="inline-flex items-center gap-2 px-6 py-3 bg-surface-2 border border-border hover:border-brand/40 text-text font-semibold rounded-xl text-sm transition-colors"
        >
          Lihat Semua Produk
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Desktop: alternate video left/right using CSS order, text always follows
     naturally on mobile since no order is set below md breakpoint. */
  @media (min-width: 768px) {
    .tutorial-item:nth-child(even) .yt-facade {
      order: 2;
    }
    .tutorial-item:nth-child(even) > div:last-child {
      order: 1;
    }
  }
</style>

<script>
  // Click-to-load YouTube facade — avoids loading the heavy YT iframe/JS
  // for videos the visitor never plays.
  document.querySelectorAll<HTMLElement>('.yt-facade').forEach((facade) => {
    function play() {
      const id = facade.dataset.youtubeId;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
      iframe.title = 'YouTube video player';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 w-full h-full';
      iframe.style.border = '0';
      facade.replaceChildren(iframe);
      facade.classList.remove('cursor-pointer');
    }
    facade.addEventListener('click', play);
    facade.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        play();
      }
    });
  });
</script>
